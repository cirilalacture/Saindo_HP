---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import TipTapRenderer from '../../components/blog/TipTapRenderer.astro';
import { getPostBySlug } from '../../db/queries/posts';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

let postData: any = null;

if (db && slug) {
  try {
    postData = await getPostBySlug(db, slug);
  } catch (err) {
    console.error('Failed to query post from D1:', err);
  }
}

if (!postData) {
  return Astro.redirect('/blog');
}

const { post, cover, author, category } = postData;
const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : 'Baru';
---

<MainLayout
  title={`${post.titleId} — Warta LPK Saindo`}
  description={post.metaDescriptionId || post.excerptId}
  lang="id"
>
  <Navbar currentLang="id" />

  <main>
    <!-- Article Header -->
    <header class="py-16 md:py-20 bg-[#FAFAF8] border-b border-brand-border">
      <Container class="max-w-4xl">
        <div class="space-y-5">
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-heading font-medium text-brand-stone">
            <a href="/" class="hover:text-brand-charcoal transition-colors">Beranda</a>
            <span>/</span>
            <a href="/blog" class="hover:text-brand-charcoal transition-colors">Blog</a>
            {category && (
              <>
                <span>/</span>
                <span class="text-brand-charcoal font-semibold">{category.nameId}</span>
              </>
            )}
          </nav>

          <div class="space-y-4">
            {category && (
              <span class="inline-block px-3 py-1 rounded-full bg-brand-sand border border-brand-border text-xs font-heading font-bold uppercase tracking-wider text-brand-vermilion">
                {category.nameId}
              </span>
            )}

            <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-heading font-extrabold text-brand-charcoal tracking-tight leading-[1.18]">
              {post.titleId}
            </h1>

            <p class="text-lg text-brand-slate font-body leading-relaxed">
              {post.excerptId}
            </p>

            <!-- Meta info: Date & Author -->
            <div class="flex items-center gap-4 pt-4 border-t border-brand-border/80 text-xs font-heading text-brand-stone">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-vermilion"></span>
                <span class="text-brand-charcoal font-semibold">{author?.name || 'Admin LPK Saindo'}</span>
              </div>
              <span>•</span>
              <time datetime={post.publishedAt}>{formattedDate}</time>
              <span>•</span>
              <span>Waktu Baca: ~4 Menit</span>
            </div>
          </div>
        </div>
      </Container>
    </header>

    <!-- Article Content -->
    <article class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container class="max-w-3xl">
        <!-- Cover Image -->
        {cover?.displayUrl && (
          <div class="mb-12 rounded-lg overflow-hidden border border-brand-border bg-brand-sand shadow-sm">
            <img
              src={cover.displayUrl}
              alt={post.titleId}
              class="w-full h-auto max-h-[500px] object-cover"
              loading="eager"
            />
          </div>
        )}

        <!-- TipTap Rendered Body -->
        <TipTapRenderer contentJson={post.contentId} />

        <!-- Bottom Share & Back Link -->
        <div class="mt-16 pt-8 border-t border-brand-border flex flex-col sm:flex-row items-center justify-between gap-4">
          <Button variant="outline" size="md" href="/blog">
            ← Kembali ke Seluruh Artikel
          </Button>

          <a
            href={`https://wa.me/?text=${encodeURIComponent(`${post.titleId} - Baca selengkapnya di LPK Saindo`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-xs font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion transition-colors"
          >
            Bagikan Artikel Ini ke WhatsApp ↗
          </a>
        </div>
      </Container>
    </article>
  </main>

  <Footer currentLang="id" />
</MainLayout>
