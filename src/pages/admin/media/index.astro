---
import { desc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, schema } from '../../../db/client';

const db = Astro.locals.runtime?.env?.DB;
let mediaList: Array<{
  id: string;
  provider: string;
  originalUrl: string;
  displayUrl: string;
  filename: string;
  altText: string | null;
  createdAt: string;
}> = [];

let noticeMessage = '';
let errorMessage = '';

if (Astro.request.method === 'POST' && db) {
  const formData = await Astro.request.formData();
  const actionType = formData.get('_action')?.toString();
  const d1 = getDb(db);

  if (actionType === 'add') {
    const url = formData.get('url')?.toString().trim();
    const filename = formData.get('filename')?.toString().trim();
    const altText = formData.get('altText')?.toString().trim() || null;
    const provider = formData.get('provider')?.toString().trim() || 'imgbb';

    if (!url || !url.startsWith('http')) {
      errorMessage = 'URL gambar harus diawali dengan http:// atau https://';
    } else if (!filename || filename.length < 2) {
      errorMessage = 'Nama berkas / label minimal 2 karakter.';
    } else {
      try {
        const mediaId = crypto.randomUUID();
        const now = new Date().toISOString();
        let mimeType = 'image/jpeg';
        const cleanUrl = url.toLowerCase();
        if (cleanUrl.endsWith('.png')) mimeType = 'image/png';
        else if (cleanUrl.endsWith('.webp')) mimeType = 'image/webp';
        else if (cleanUrl.endsWith('.gif')) mimeType = 'image/gif';

        await d1.insert(schema.media).values({
          id: mediaId,
          provider,
          providerImageId: null,
          originalUrl: url,
          displayUrl: url,
          thumbnailUrl: url,
          filename,
          mimeType,
          fileSize: 0,
          altText,
          createdAt: now,
        });
        noticeMessage = `Media "${filename}" berhasil didaftarkan ke library.`;
      } catch (err: any) {
        console.error('Failed to add media link:', err);
        errorMessage = err.message || 'Gagal menambahkan link media ke database.';
      }
    }
  } else if (actionType === 'delete') {
    const mediaId = formData.get('mediaId')?.toString();
    if (mediaId) {
      try {
        // Safety check: is it used in posts?
        const postUsage = await d1
          .select({ id: schema.posts.id, titleId: schema.posts.titleId })
          .from(schema.posts)
          .where(eq(schema.posts.coverMediaId, mediaId))
          .limit(1);

        if (postUsage.length > 0) {
          errorMessage = `Gambar tidak dapat dihapus karena menjadi sampul artikel: "${postUsage[0].titleId}".`;
        } else {
          // Safety check: is it used in gallery albums cover?
          const albumUsage = await d1
            .select({ id: schema.galleryAlbums.id, titleId: schema.galleryAlbums.titleId })
            .from(schema.galleryAlbums)
            .where(eq(schema.galleryAlbums.coverMediaId, mediaId))
            .limit(1);

          if (albumUsage.length > 0) {
            errorMessage = `Gambar tidak dapat dihapus karena menjadi sampul album: "${albumUsage[0].titleId}".`;
          } else {
            // Safety check: is it used as an item photo?
            const itemUsage = await d1
              .select({ id: schema.galleryItems.id })
              .from(schema.galleryItems)
              .where(eq(schema.galleryItems.mediaId, mediaId))
              .limit(1);

            if (itemUsage.length > 0) {
              errorMessage = 'Gambar tidak dapat dihapus karena masih tercantum sebagai item foto dalam album galeri.';
            } else {
              await d1.delete(schema.media).where(eq(schema.media.id, mediaId));
              noticeMessage = 'Berkas media berhasil dihapus.';
            }
          }
        }
      } catch (err: any) {
        console.error('Failed to delete media:', err);
        errorMessage = 'Terjadi kesalahan teknis saat menghapus media.';
      }
    }
  }
}

if (db) {
  const d1 = getDb(db);
  try {
    mediaList = await d1
      .select({
        id: schema.media.id,
        provider: schema.media.provider,
        originalUrl: schema.media.originalUrl,
        displayUrl: schema.media.displayUrl,
        filename: schema.media.filename,
        altText: schema.media.altText,
        createdAt: schema.media.createdAt,
      })
      .from(schema.media)
      .orderBy(desc(schema.media.createdAt));
  } catch (err) {
    console.error('Failed to query media library:', err);
  }
}
---

<AdminLayout title="Media Library (Katalog Gambar)" activeNav="media">
  <div class="space-y-8">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-brand-border">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 text-xs font-heading font-bold text-brand-vermilion uppercase tracking-widest">
          <span>MEDIA LIBRARY</span>
          <span class="text-brand-stone">/</span>
          <span class="font-japanese text-brand-stone font-normal">メディア管理</span>
        </div>
        <h1 class="text-2xl font-heading font-extrabold text-brand-charcoal tracking-tight">
          Katalog Gambar & Berkas Visual
        </h1>
        <p class="text-xs text-brand-slate font-body">
          Daftarkan tautan gambar langsung dari internet (ImgBB direct link, Unsplash, CDN) untuk dipakai pada warta dan album.
        </p>
      </div>

      <div class="text-xs font-heading font-semibold text-brand-stone">
        Total: <strong class="text-brand-charcoal">{mediaList.length}</strong> gambar terdaftar
      </div>
    </div>

    <!-- Alert Notifications -->
    {noticeMessage && (
      <div class="p-4 rounded-md bg-green-50 border border-green-200 text-green-800 text-xs font-heading font-medium flex items-center justify-between">
        <span>{noticeMessage}</span>
      </div>
    )}

    {errorMessage && (
      <div class="p-4 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-heading font-medium flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-brand-vermilion" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Add Media URL Form Box -->
    <div class="p-6 rounded-xl bg-white border border-brand-border shadow-sm space-y-4">
      <div class="flex items-center gap-2 pb-2 border-b border-brand-border">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-vermilion"></span>
        <h2 class="text-sm font-heading font-bold uppercase tracking-wider text-brand-charcoal">
          Daftarkan Gambar Baru dari Link Internet
        </h2>
      </div>

      <form method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
        <input type="hidden" name="_action" value="add" />

        <div class="md:col-span-2 space-y-1">
          <label for="url" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
            URL Gambar Langsung (Direct Link) <span class="text-brand-vermilion">*</span>
          </label>
          <input
            id="url"
            name="url"
            type="url"
            required
            placeholder="https://i.ibb.co/xyz123/foto-pelatihan.jpg"
            class="w-full px-3.5 py-2 rounded border border-brand-border text-xs text-brand-charcoal font-mono bg-white focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
          />
        </div>

        <div class="space-y-1">
          <label for="filename" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
            Nama / Label Berkas <span class="text-brand-vermilion">*</span>
          </label>
          <input
            id="filename"
            name="filename"
            type="text"
            required
            placeholder="kelas-kaiwa-15.webp"
            class="w-full px-3.5 py-2 rounded border border-brand-border text-xs text-brand-charcoal font-sans bg-white focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
          />
        </div>

        <div class="space-y-1">
          <label for="provider" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
            Penyedia / Sumber
          </label>
          <select
            id="provider"
            name="provider"
            class="w-full px-3.5 py-2 rounded border border-brand-border text-xs font-heading text-brand-charcoal bg-brand-porcelain focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
          >
            <option value="imgbb">ImgBB</option>
            <option value="unsplash">Unsplash</option>
            <option value="external_link">Eksternal Lainnya</option>
          </select>
        </div>

        <div class="md:col-span-3 space-y-1">
          <label for="altText" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-stone">
            Deskripsi Alt Text (Aksesibilitas & SEO)
          </label>
          <input
            id="altText"
            name="altText"
            type="text"
            placeholder="Foto suasana latihan percakapan siswa bersama native speaker"
            class="w-full px-3.5 py-2 rounded border border-brand-border text-xs text-brand-charcoal font-sans bg-white focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
          />
        </div>

        <div>
          <button
            type="submit"
            class="w-full py-2 px-4 rounded bg-brand-charcoal hover:bg-brand-vermilion text-white font-heading font-bold text-xs tracking-wider transition-colors shadow-sm flex items-center justify-center gap-1.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span>Daftarkan Media</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Media Grid Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {mediaList.length > 0 ? (
        mediaList.map((item) => (
          <div class="rounded-xl bg-white border border-brand-border overflow-hidden shadow-sm flex flex-col justify-between group hover:border-brand-charcoal transition-all">
            
            <!-- Thumbnail preview -->
            <div class="aspect-[16/10] bg-brand-sand overflow-hidden relative">
              <img
                src={item.displayUrl}
                alt={item.altText || item.filename}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded bg-black/70 text-white text-[10px] font-heading font-bold uppercase tracking-wider backdrop-blur-sm">
                {item.provider}
              </span>
            </div>

            <!-- Info & Actions -->
            <div class="p-4 space-y-3">
              <div>
                <p class="font-heading font-bold text-xs text-brand-charcoal truncate" title={item.filename}>
                  {item.filename}
                </p>
                {item.altText && (
                  <p class="text-[11px] text-brand-stone font-body line-clamp-1 mt-0.5" title={item.altText}>
                    {item.altText}
                  </p>
                )}
              </div>

              <!-- Action buttons -->
              <div class="pt-3 border-t border-brand-border/60 flex items-center justify-between gap-2">
                
                <!-- Copy URL Button -->
                <button
                  type="button"
                  data-url={item.displayUrl}
                  onclick="navigator.clipboard.writeText(this.dataset.url); alert('URL disalin ke clipboard!');"
                  class="px-2.5 py-1.5 rounded bg-brand-sand hover:bg-brand-border text-brand-charcoal text-[11px] font-heading font-semibold transition-colors flex items-center gap-1"
                  title="Salin URL Gambar"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                  </svg>
                  <span>Salin URL</span>
                </button>

                <!-- Open original link -->
                <a
                  href={item.displayUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-1.5 rounded text-brand-stone hover:text-brand-charcoal hover:bg-brand-sand transition-colors"
                  title="Buka Gambar Asli di Tab Baru"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>

                <!-- Delete Media Form -->
                <form method="POST" onsubmit="return confirm('Hapus berkas gambar ini dari media library?');" class="inline">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="mediaId" value={item.id} />
                  <button
                    type="submit"
                    class="p-1.5 rounded hover:bg-red-50 text-brand-stone hover:text-red-600 transition-colors"
                    title="Hapus Media"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </form>

              </div>
            </div>

          </div>
        ))
      ) : (
        <div class="col-span-full py-16 text-center text-brand-stone font-heading text-xs bg-white rounded-xl border border-brand-border">
          Belum ada berkas gambar yang didaftarkan. Gunakan formulir di atas untuk menambahkan link gambar internet.
        </div>
      )}
    </div>

  </div>
</AdminLayout>
