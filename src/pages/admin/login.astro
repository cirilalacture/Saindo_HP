---
import '../../styles/global.css';
import { eq } from 'drizzle-orm';
import { getDb, schema } from '../../db/client';
import {
  verifyPassword,
  createSession,
  updateUserLastLogin,
  SESSION_COOKIE_NAME,
  SESSION_MAX_AGE_SECONDS,
} from '../../lib/auth';

let errorMessage = '';
const redirectParam = Astro.url.searchParams.get('redirect') || '/admin/dashboard';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email')?.toString().trim().toLowerCase() || '';
    const password = formData.get('password')?.toString() || '';

    if (!email || !password) {
      errorMessage = 'Email dan kata sandi wajib diisi.';
    } else {
      const db = Astro.locals.runtime?.env?.DB;
      if (!db) {
        errorMessage = 'Koneksi Cloudflare D1 tidak terdeteksi.';
      } else {
        const foundUsers = await getDb(db)
          .select()
          .from(schema.users)
          .where(eq(schema.users.email, email))
          .limit(1);

        if (foundUsers.length === 0) {
          errorMessage = 'Email atau kata sandi tidak sesuai.';
        } else {
          const user = foundUsers[0];
          if (user.isActive !== 1) {
            errorMessage = 'Akun ini dinonaktifkan oleh sistem.';
          } else {
            const isMatch = await verifyPassword(password, user.passwordHash);
            if (!isMatch) {
              errorMessage = 'Email atau kata sandi tidak sesuai.';
            } else {
              const { token } = await createSession(db, user.id);
              await updateUserLastLogin(db, user.id);

              Astro.cookies.set(SESSION_COOKIE_NAME, token, {
                path: '/',
                httpOnly: true,
                secure: import.meta.env.PROD,
                sameSite: 'strict',
                maxAge: SESSION_MAX_AGE_SECONDS,
              });

              return Astro.redirect(redirectParam);
            }
          }
        }
      }
    }
  } catch (err) {
    console.error('Error during login execution:', err);
    errorMessage = 'Terjadi kendala teknis saat memproses autentikasi.';
  }
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Masuk Admin CMS — LPK Saindo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#FAFAF8] text-brand-charcoal font-sans antialiased flex flex-col justify-between selection:bg-brand-vermilion selection:text-white">
    
    <!-- Top Header Subtle Bar -->
    <header class="py-6 px-6 sm:px-10 border-b border-brand-border bg-white/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded bg-brand-vermilion text-white flex items-center justify-center font-heading font-black text-lg tracking-wider shadow-sm group-hover:bg-brand-vermilion-dark transition-colors">
            S
          </div>
          <div class="flex flex-col">
            <span class="font-heading font-extrabold text-base tracking-tight text-brand-charcoal leading-none">
              LPK SAINDO
            </span>
            <span class="font-japanese text-[10px] text-brand-stone font-medium tracking-widest mt-0.5">
              送り出し機関
            </span>
          </div>
        </a>

        <a
          href="/"
          class="text-xs font-heading font-semibold text-brand-slate hover:text-brand-charcoal inline-flex items-center gap-1.5 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Kembali ke Beranda
        </a>
      </div>
    </header>

    <!-- Center Card -->
    <main class="flex-1 flex items-center justify-center p-6 sm:p-10">
      <div class="w-full max-w-md">
        
        <!-- Login Card Box -->
        <div class="card-shoji rounded-xl bg-white border border-brand-border p-8 sm:p-10 shadow-sm relative overflow-hidden">
          
          <!-- Decorative Top Accent Line -->
          <div class="absolute top-0 left-0 right-0 h-1 bg-brand-vermilion"></div>

          <div class="text-center space-y-2 mb-8">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-sand/60 border border-brand-border text-[11px] font-heading font-bold text-brand-slate uppercase tracking-wider">
              <span>ADMINISTRASI</span>
              <span class="text-brand-stone">/</span>
              <span class="font-japanese text-brand-stone font-medium">管理ポータル</span>
            </div>
            <h1 class="text-2xl font-heading font-extrabold text-brand-charcoal tracking-tight">
              Masuk ke CMS Portal
            </h1>
            <p class="text-xs text-brand-slate font-body">
              Gunakan kredensial akun administrator Anda untuk mengelola konten dan dokumentasi LPK Saindo.
            </p>
          </div>

          <!-- Alert error message -->
          {errorMessage && (
            <div class="mb-6 p-4 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-heading font-medium flex items-start gap-2.5">
              <svg class="w-4 h-4 text-brand-vermilion shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{errorMessage}</span>
            </div>
          )}

          <!-- Login Form -->
          <form method="POST" class="space-y-5">
            <div class="space-y-1.5">
              <label for="email" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
                Alamat Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="admin@lpksaindo.com"
                class="w-full px-4 py-2.5 rounded border border-brand-border bg-brand-porcelain focus:bg-white text-sm text-brand-charcoal font-sans transition-colors focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
              />
            </div>

            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="password" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
                  Kata Sandi
                </label>
              </div>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                placeholder="••••••••••••"
                class="w-full px-4 py-2.5 rounded border border-brand-border bg-brand-porcelain focus:bg-white text-sm text-brand-charcoal font-sans transition-colors focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
              />
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 rounded bg-brand-charcoal hover:bg-brand-vermilion text-white font-heading font-bold text-sm tracking-wide transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-vermilion focus:ring-offset-2 flex items-center justify-center gap-2"
            >
              <span>Masuk ke Dashboard</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </form>

          <div class="mt-6 pt-6 border-t border-brand-border/60 text-center">
            <p class="text-[11px] text-brand-stone font-heading">
              Akses terbatas hanya untuk staf & pengelola resmi LPK Saindo.
            </p>
          </div>

        </div>

      </div>
    </main>

    <!-- Footer Copyright -->
    <footer class="py-6 text-center text-xs text-brand-stone font-heading border-t border-brand-border/60">
      &copy; {new Date().getFullYear()} LPK Saindo. All rights reserved.
    </footer>

  </body>
</html>
