---
import { eq } from 'drizzle-orm';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb, schema } from '../../../../db/client';

const { id } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

if (!id || !db) {
  return Astro.redirect('/admin/gallery');
}

const d1 = getDb(db);
const albumRes = await d1.select().from(schema.galleryAlbums).where(eq(schema.galleryAlbums.id, id)).limit(1);

if (albumRes.length === 0) {
  return Astro.redirect('/admin/gallery');
}

const album = albumRes[0];

let noticeMessage = '';
let errorMessage = '';

// Handle POST actions: add photo item or delete photo item
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const actionType = formData.get('_action')?.toString();

  if (actionType === 'add_item') {
    let mediaId = formData.get('mediaId')?.toString().trim() || null;
    const directUrl = formData.get('directUrl')?.toString().trim() || null;
    const filename = formData.get('filename')?.toString().trim() || null;
    const captionId = formData.get('captionId')?.toString().trim() || null;
    const captionJa = formData.get('captionJa')?.toString().trim() || null;
    const altText = formData.get('altText')?.toString().trim() || null;
    const sortOrder = parseInt(formData.get('sortOrder')?.toString() || '0', 10);

    const now = new Date().toISOString();

    // If direct link provided instead of existing library media
    if (!mediaId && directUrl && directUrl.startsWith('http')) {
      try {
        mediaId = crypto.randomUUID();
        await d1.insert(schema.media).values({
          id: mediaId,
          provider: 'imgbb',
          providerImageId: null,
          originalUrl: directUrl,
          displayUrl: directUrl,
          thumbnailUrl: directUrl,
          filename: filename || `album-item-${Date.now()}.webp`,
          mimeType: 'image/jpeg',
          fileSize: 0,
          altText,
          createdAt: now,
        });
      } catch (err: any) {
        console.error('Failed to create media record:', err);
      }
    }

    if (!mediaId) {
      errorMessage = 'Pilih media dari library atau masukkan tautan URL gambar valid.';
    } else {
      try {
        const itemId = crypto.randomUUID();
        await d1.insert(schema.galleryItems).values({
          id: itemId,
          albumId: id,
          mediaId,
          captionId,
          captionJa,
          altText,
          sortOrder,
          createdAt: now,
        });
        noticeMessage = 'Foto berhasil ditambahkan ke album.';
      } catch (err: any) {
        console.error('Failed to add gallery item:', err);
        errorMessage = 'Gagal menambahkan foto ke album.';
      }
    }
  } else if (actionType === 'delete_item') {
    const itemId = formData.get('itemId')?.toString();
    if (itemId) {
      try {
        await d1.delete(schema.galleryItems).where(eq(schema.galleryItems.id, itemId));
        noticeMessage = 'Foto dihapus dari album.';
      } catch (err: any) {
        console.error('Failed to delete item:', err);
        errorMessage = 'Gagal menghapus item foto.';
      }
    }
  }
}

// Fetch photos in album
const items = await d1
  .select({
    id: schema.galleryItems.id,
    captionId: schema.galleryItems.captionId,
    captionJa: schema.galleryItems.captionJa,
    altText: schema.galleryItems.altText,
    sortOrder: schema.galleryItems.sortOrder,
    createdAt: schema.galleryItems.createdAt,
    displayUrl: schema.media.displayUrl,
    filename: schema.media.filename,
    provider: schema.media.provider,
  })
  .from(schema.galleryItems)
  .leftJoin(schema.media, eq(schema.galleryItems.mediaId, schema.media.id))
  .where(eq(schema.galleryItems.albumId, id))
  .orderBy(schema.galleryItems.sortOrder);

// Fetch media library options for selector
const mediaLibrary = await d1
  .select({ id: schema.media.id, filename: schema.media.filename, displayUrl: schema.media.displayUrl })
  .from(schema.media);
---

<AdminLayout title={`Kelola Foto: ${album.titleId}`} activeNav="gallery">
  <div class="space-y-8">
    
    <!-- Header Back Breadcrumb -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-brand-border">
      <div class="space-y-1">
        <a href="/admin/gallery" class="text-xs font-heading font-semibold text-brand-slate hover:text-brand-charcoal inline-flex items-center gap-1.5 transition-colors">
          ← Kembali ke Daftar Album
        </a>
        <h1 class="text-2xl font-heading font-extrabold text-brand-charcoal tracking-tight">
          Kelola Foto: {album.titleId}
        </h1>
        <p class="text-xs text-brand-slate font-body">
          Tambahkan foto dokumentasi kegiatan dari Media Library atau masukkan URL gambar langsung.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`/gallery/${album.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2 rounded bg-brand-sand hover:bg-brand-border text-brand-charcoal text-xs font-heading font-bold transition-colors inline-flex items-center gap-1.5"
        >
          <span>Lihat Album Publik</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Alert Notifications -->
    {noticeMessage && (
      <div class="p-4 rounded-md bg-green-50 border border-green-200 text-green-800 text-xs font-heading font-medium flex items-center justify-between">
        <span>{noticeMessage}</span>
      </div>
    )}

    {errorMessage && (
      <div class="p-4 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-heading font-medium flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-brand-vermilion" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Add Photo Form Accordion / Card -->
    <div class="p-6 rounded-xl bg-white border border-brand-border shadow-sm space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-brand-border">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-vermilion"></span>
          <h2 class="text-sm font-heading font-bold uppercase tracking-wider text-brand-charcoal">
            Tambah Foto ke Album
          </h2>
        </div>
        <span class="text-[11px] text-brand-stone font-heading">
          {items.length} Foto Terdaftar
        </span>
      </div>

      <form method="POST" class="space-y-4">
        <input type="hidden" name="_action" value="add_item" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Option A: Select from library -->
          <div class="space-y-1">
            <label for="mediaId" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Pilihan 1: Dari Media Library
            </label>
            <select
              id="mediaId"
              name="mediaId"
              class="w-full px-3.5 py-2 rounded border border-brand-border bg-brand-porcelain text-xs font-heading text-brand-charcoal focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
            >
              <option value="">— Pilih Foto dari Library —</option>
              {mediaLibrary.map((m) => (
                <option value={m.id}>{m.filename}</option>
              ))}
            </select>
          </div>

          <!-- Option B: Direct image link -->
          <div class="space-y-1">
            <label for="directUrl" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Pilihan 2: Atau Masukkan Link URL Gambar Baru
            </label>
            <input
              id="directUrl"
              name="directUrl"
              type="url"
              placeholder="https://i.ibb.co/xyz/foto.webp"
              class="w-full px-3.5 py-2 rounded border border-brand-border text-xs text-brand-charcoal font-mono bg-white focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          <div class="space-y-1">
            <label for="captionId" class="block text-xs font-heading font-semibold text-brand-stone">
              Keterangan Foto (ID)
            </label>
            <input
              id="captionId"
              name="captionId"
              type="text"
              placeholder="Contoh: Penyerahan sertifikat kelulusan JLPT"
              class="w-full px-3 py-1.5 rounded border border-brand-border text-xs text-brand-charcoal font-sans bg-white focus:outline-none focus:ring-1 focus:ring-brand-vermilion"
            />
          </div>

          <div class="space-y-1">
            <label for="captionJa" class="block text-xs font-heading font-semibold text-brand-stone">
              Keterangan Foto (JA - Opsional)
            </label>
            <input
              id="captionJa"
              name="captionJa"
              type="text"
              placeholder="例: 修了証書授与式の様子"
              class="w-full px-3 py-1.5 rounded border border-brand-border text-xs text-brand-charcoal font-ja bg-white focus:outline-none focus:ring-1 focus:ring-brand-vermilion"
            />
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div class="space-y-1">
              <label for="sortOrder" class="block text-xs font-heading font-semibold text-brand-stone">
                Nomor Urut
              </label>
              <input
                id="sortOrder"
                name="sortOrder"
                type="number"
                value={items.length + 1}
                class="w-full px-3 py-1.5 rounded border border-brand-border text-xs font-mono text-brand-charcoal bg-white focus:outline-none focus:ring-1 focus:ring-brand-vermilion"
              />
            </div>

            <div class="flex items-end">
              <button
                type="submit"
                class="w-full py-2 px-3 rounded bg-brand-charcoal hover:bg-brand-vermilion text-white font-heading font-bold text-xs tracking-wide transition-colors shadow-sm flex items-center justify-center gap-1.5"
              >
                <span>+ Simpan Foto</span>
              </button>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Photos Grid in this album -->
    <div class="space-y-3">
      <h2 class="text-xs font-heading font-bold uppercase tracking-wider text-brand-stone">
        Foto-Foto Dalam Album Ini ({items.length})
      </h2>

      {items.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {items.map((item, idx) => (
            <div class="rounded-xl bg-white border border-brand-border overflow-hidden shadow-sm flex flex-col justify-between group hover:border-brand-charcoal transition-all">
              
              <div class="aspect-[4/3] bg-brand-sand overflow-hidden relative">
                <img
                  src={item.displayUrl || 'https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&fit=crop&w=600&q=80'}
                  alt={item.captionId || 'Foto Album'}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-black/75 text-white text-[10px] font-heading font-bold">
                  #{item.sortOrder || idx + 1}
                </span>
              </div>

              <div class="p-3.5 space-y-2">
                <div class="space-y-0.5">
                  <p class="font-heading font-bold text-xs text-brand-charcoal line-clamp-1">
                    {item.captionId || item.filename || 'Tanpa Keterangan'}
                  </p>
                  {item.captionJa && (
                    <p class="font-japanese text-[11px] text-brand-stone line-clamp-1">
                      {item.captionJa}
                    </p>
                  )}
                </div>

                <div class="pt-2 border-t border-brand-border/60 flex items-center justify-between">
                  <span class="text-[10px] text-brand-stone font-mono">
                    {item.provider}
                  </span>

                  <form method="POST" onsubmit="return confirm('Hapus foto ini dari album?');" class="inline">
                    <input type="hidden" name="_action" value="delete_item" />
                    <input type="hidden" name="itemId" value={item.id} />
                    <button
                      type="submit"
                      class="px-2 py-1 rounded hover:bg-red-50 text-red-600 text-[11px] font-heading font-semibold transition-colors"
                    >
                      Hapus
                    </button>
                  </form>
                </div>
              </div>

            </div>
          ))}
        </div>
      ) : (
        <div class="py-16 text-center text-brand-stone font-heading text-xs bg-white rounded-xl border border-brand-border">
          Album ini belum memiliki foto. Gunakan formulir di atas untuk menambahkan foto pertama.
        </div>
      )}
    </div>

  </div>
</AdminLayout>
