---
import { eq } from 'drizzle-orm';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb, schema } from '../../../../db/client';
import { resolveCoverMediaId } from '../../../../lib/media';

const { id } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

if (!id || !db) {
  return Astro.redirect('/admin/gallery');
}

const d1 = getDb(db);
const albumRes = await d1.select().from(schema.galleryAlbums).where(eq(schema.galleryAlbums.id, id)).limit(1);

if (albumRes.length === 0) {
  return Astro.redirect('/admin/gallery');
}

const album = albumRes[0];

// Query current cover URL if present
let currentCoverUrl = '';
if (album.coverMediaId) {
  const currentCoverMedia = await d1
    .select({ displayUrl: schema.media.displayUrl })
    .from(schema.media)
    .where(eq(schema.media.id, album.coverMediaId))
    .limit(1);
  if (currentCoverMedia.length > 0) {
    currentCoverUrl = currentCoverMedia[0].displayUrl;
  }
}

const mediaList = await d1
  .select({ id: schema.media.id, filename: schema.media.filename, displayUrl: schema.media.displayUrl })
  .from(schema.media);

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const titleId = formData.get('titleId')?.toString().trim();
    const titleJa = formData.get('titleJa')?.toString().trim() || null;
    let slug = formData.get('slug')?.toString().trim();
    const descriptionId = formData.get('descriptionId')?.toString().trim() || null;
    const descriptionJa = formData.get('descriptionJa')?.toString().trim() || null;
    const eventDate = formData.get('eventDate')?.toString().trim() || null;
    const externalCoverUrl = formData.get('externalCoverUrl')?.toString().trim() || null;
    const coverMediaIdInput = formData.get('coverMediaId')?.toString().trim() || null;
    const isPublished = formData.get('isPublished')?.toString() === '1' ? 1 : 0;
    const sortOrder = parseInt(formData.get('sortOrder')?.toString() || '0', 10);

    if (!titleId || titleId.length < 3) {
      errorMessage = 'Judul album Indonesia minimal 3 karakter.';
    } else {
      if (!slug) {
        slug = titleId
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      // Resolve cover from external URL or media library
      const coverMediaId = await resolveCoverMediaId(db, {
        externalUrl: externalCoverUrl,
        selectedMediaId: coverMediaIdInput,
        title: titleId,
      });

      await d1
        .update(schema.galleryAlbums)
        .set({
          titleId,
          titleJa,
          slug,
          descriptionId,
          descriptionJa,
          coverMediaId,
          isPublished,
          sortOrder,
          eventDate,
          updatedAt: new Date().toISOString(),
        })
        .where(eq(schema.galleryAlbums.id, id));

      return Astro.redirect('/admin/gallery');
    }
  } catch (err: any) {
    console.error('Failed to update album:', err);
    errorMessage = err.message || 'Gagal memperbarui album.';
  }
}
---

<AdminLayout title={`Edit Album: ${album.titleId}`} activeNav="gallery">
  <div class="space-y-6 max-w-4xl">
    
    <!-- Header Back Breadcrumb -->
    <div class="flex items-center justify-between pb-4 border-b border-brand-border">
      <div class="space-y-1">
        <a href="/admin/gallery" class="text-xs font-heading font-semibold text-brand-slate hover:text-brand-charcoal inline-flex items-center gap-1.5 transition-colors">
          ← Kembali ke Daftar Album
        </a>
        <h1 class="text-2xl font-heading font-extrabold text-brand-charcoal tracking-tight">
          Perbarui Album: {album.titleId}
        </h1>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`/admin/gallery/${album.id}/items`}
          class="px-3.5 py-2 rounded bg-brand-sand hover:bg-brand-border text-brand-charcoal text-xs font-heading font-bold transition-colors inline-flex items-center gap-1.5"
        >
          <span>Kelola Foto Album</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Error Alert Box -->
    {errorMessage && (
      <div class="p-4 rounded-md bg-red-50 border border-red-200 text-red-700 text-xs font-heading font-medium flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0 text-brand-vermilion" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Form Box -->
    <div class="p-8 rounded-xl bg-white border border-brand-border shadow-sm">
      <form method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1.5">
            <label for="titleId" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Judul Album (ID) <span class="text-brand-vermilion">*</span>
            </label>
            <input
              id="titleId"
              name="titleId"
              type="text"
              required
              value={album.titleId}
              class="w-full px-4 py-2.5 rounded border border-brand-border bg-white text-sm text-brand-charcoal font-sans focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
            />
          </div>

          <div class="space-y-1.5">
            <label for="titleJa" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Judul Album (JA - Opsional)
            </label>
            <input
              id="titleJa"
              name="titleJa"
              type="text"
              value={album.titleJa || ''}
              class="w-full px-4 py-2.5 rounded border border-brand-border bg-white text-sm text-brand-charcoal font-ja focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1.5">
            <label for="slug" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Slug URL
            </label>
            <div class="flex rounded border border-brand-border bg-brand-sand/30 overflow-hidden focus-within:ring-2 focus-within:ring-brand-vermilion/20 focus-within:border-brand-vermilion">
              <span class="px-3 py-2 text-xs font-mono text-brand-stone border-r border-brand-border">
                /gallery/
              </span>
              <input
                id="slug"
                name="slug"
                type="text"
                value={album.slug}
                class="flex-1 px-3 py-2 bg-transparent text-xs text-brand-charcoal font-mono focus:outline-none"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="eventDate" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Tanggal / Bulan Kegiatan
            </label>
            <input
              id="eventDate"
              name="eventDate"
              type="text"
              value={album.eventDate || ''}
              class="w-full px-4 py-2 rounded border border-brand-border bg-white text-xs text-brand-charcoal font-sans focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-1.5">
            <label for="descriptionId" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Keterangan Album (ID)
            </label>
            <textarea
              id="descriptionId"
              name="descriptionId"
              rows="3"
              class="w-full px-4 py-2 rounded border border-brand-border bg-white text-xs text-brand-charcoal font-sans focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion leading-relaxed"
            >{album.descriptionId || ''}</textarea>
          </div>

          <div class="space-y-1.5">
            <label for="descriptionJa" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Keterangan Album (JA - Opsional)
            </label>
            <textarea
              id="descriptionJa"
              name="descriptionJa"
              rows="3"
              class="w-full px-4 py-2 rounded border border-brand-border bg-white text-xs text-brand-charcoal font-ja focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion leading-relaxed"
            >{album.descriptionJa || ''}</textarea>
          </div>
        </div>

        <!-- Cover Image Options -->
        <div class="p-5 rounded-lg border border-brand-border bg-brand-porcelain/60 space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-brand-border/80">
            <span class="w-2 h-2 rounded-full bg-brand-vermilion"></span>
            <h3 class="text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Pengaturan Sampul Album
            </h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Option A: External URL -->
            <div class="space-y-1.5">
              <label for="externalCoverUrl" class="block text-xs font-heading font-bold text-brand-charcoal">
                Pilihan 1: Tautan URL Gambar Eksternal (ImgBB, dll)
              </label>
              <input
                id="externalCoverUrl"
                name="externalCoverUrl"
                type="url"
                placeholder="https://i.ibb.co/xyz/sampul.jpg"
                class="w-full px-3.5 py-2 rounded border border-brand-border bg-white text-xs font-mono text-brand-charcoal focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion placeholder:text-brand-stone"
              />
              <p class="text-[11px] font-body text-brand-stone">
                Masukkan URL baru dari ImgBB, Unsplash, atau hosting gambar lainnya.
              </p>
            </div>

            <!-- Option B: Select from library -->
            <div class="space-y-1.5">
              <label for="coverMediaId" class="block text-xs font-heading font-bold text-brand-charcoal">
                Pilihan 2: Atau Pilih dari Media Library
              </label>
              <select
                id="coverMediaId"
                name="coverMediaId"
                class="w-full px-3 py-2 rounded border border-brand-border bg-white text-xs font-heading text-brand-charcoal focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
              >
                <option value="" data-url="">— Tanpa Sampul —</option>
                {mediaList.map((med) => (
                  <option
                    value={med.id}
                    data-url={med.displayUrl}
                    selected={med.id === album.coverMediaId}
                  >
                    {med.filename}
                  </option>
                ))}
              </select>
              <p class="text-[11px] font-body text-brand-stone">
                Pilih dari koleksi gambar yang telah tersimpan sebelumnya.
              </p>
            </div>
          </div>

          <!-- Live Preview Box -->
          <div class="pt-2">
            <span class="block text-[11px] font-heading font-semibold text-brand-stone mb-1.5">
              Pratinjau Sampul Saat Ini:
            </span>
            <div class="w-full max-w-xs aspect-[16/9] rounded border border-dashed border-brand-border bg-brand-sand/40 overflow-hidden relative flex items-center justify-center">
              <img
                id="coverPreviewImg"
                src={currentCoverUrl}
                alt="Pratinjau Sampul"
                class={`w-full h-full object-cover ${currentCoverUrl ? '' : 'hidden'}`}
              />
              <span id="coverPreviewPlaceholder" class={`text-xs text-brand-stone font-heading ${currentCoverUrl ? 'hidden' : ''}`}>
                Belum ada foto sampul
              </span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-brand-border/60">
          <div class="space-y-1.5">
            <label for="isPublished" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Status Publikasi
            </label>
            <select
              id="isPublished"
              name="isPublished"
              class="w-full px-3 py-2 rounded border border-brand-border bg-brand-porcelain text-xs font-heading font-bold text-brand-charcoal focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
            >
              <option value="1" selected={album.isPublished === 1}>Terbitkan Langsung (Publik)</option>
              <option value="0" selected={album.isPublished === 0}>Draf (Belum Tayang)</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="sortOrder" class="block text-xs font-heading font-bold uppercase tracking-wider text-brand-charcoal">
              Urutan Prioritas (Sort Order)
            </label>
            <input
              id="sortOrder"
              name="sortOrder"
              type="number"
              value={album.sortOrder}
              class="w-full px-3 py-2 rounded border border-brand-border bg-white text-xs font-mono text-brand-charcoal focus:outline-none focus:ring-2 focus:ring-brand-vermilion/20 focus:border-brand-vermilion"
            />
          </div>
        </div>

        <div class="pt-6 border-t border-brand-border/60 flex items-center justify-end gap-3">
          <a
            href="/admin/gallery"
            class="px-4 py-2.5 rounded border border-brand-border hover:bg-brand-sand text-brand-slate font-heading font-semibold text-xs transition-colors"
          >
            Batal
          </a>
          <button
            type="submit"
            class="px-5 py-2.5 rounded bg-brand-charcoal hover:bg-brand-vermilion text-white font-heading font-bold text-xs tracking-wider transition-colors shadow-sm"
          >
            Perbarui Album
          </button>
        </div>

      </form>
    </div>

  </div>

  <script is:inline>
    (function() {
      const urlInput = document.getElementById('externalCoverUrl');
      const selectMedia = document.getElementById('coverMediaId');
      const previewImg = document.getElementById('coverPreviewImg');
      const placeholder = document.getElementById('coverPreviewPlaceholder');

      function updatePreview() {
        const urlVal = urlInput ? urlInput.value.trim() : '';
        let targetUrl = '';

        if (urlVal && (urlVal.startsWith('http://') || urlVal.startsWith('https://'))) {
          targetUrl = urlVal;
        } else if (selectMedia && selectMedia.value) {
          const selectedOption = selectMedia.options[selectMedia.selectedIndex];
          targetUrl = selectedOption ? selectedOption.getAttribute('data-url') || '' : '';
        }

        if (targetUrl) {
          previewImg.src = targetUrl;
          previewImg.classList.remove('hidden');
          placeholder.classList.add('hidden');
        } else {
          previewImg.src = '';
          previewImg.classList.add('hidden');
          placeholder.classList.remove('hidden');
        }
      }

      if (urlInput) {
        urlInput.addEventListener('input', function() {
          if (urlInput.value.trim() && selectMedia) {
            selectMedia.value = '';
          }
          updatePreview();
        });
      }

      if (selectMedia) {
        selectMedia.addEventListener('change', function() {
          if (selectMedia.value && urlInput) {
            urlInput.value = '';
          }
          updatePreview();
        });
      }
    })();
  </script>
</AdminLayout>
