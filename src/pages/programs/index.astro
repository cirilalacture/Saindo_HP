---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { programsData } from '../../data/programs';
---

<MainLayout
  title="Program Pelatihan & Biaya — LPK Saindo (Saindo Passion Global)"
  description="Daftar program resmi LPK Saindo di Sragen: Tokutei Ginou (SSW), Engineer / Gijinkoku, 4 Jenjang Kelas, dan Matching Job mandiri dengan skema pembiayaan transparan include visa & tiket pesawat."
  lang="id"
>
  <Navbar currentLang="id" />

  <main>
    <!-- Banner Header -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>KATALOG PROGRAM & KELAS</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">研修プログラム一覧</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            Pilih Program Pelatihan & Jalur Kerja Resmi ke Jepang.
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            LPK Saindo (Saindo Passion Global) di Sragen mengkhususkan diri pada program <strong>Tokutei Ginou (SSW)</strong> dan <strong>Engineer / Gijinkoku</strong>. Kami membuka 4 kelas pembelajaran terarah serta program Matching Job langsung ke perusahaan Jepang dengan pembiayaan transparan.
          </p>
        </div>
      </Container>
    </section>

    <!-- Transparent Pricing Matrix Section -->
    <section class="py-16 bg-white border-b border-brand-border">
      <Container>
        <SectionHeader
          tagline="TRANSPARANSI BIAYA"
          taglineJa="料金体系"
          title="Rincian Pembiayaan Terbuka & Jelas"
          description="Di LPK Saindo, seluruh biaya pendidikan dan penyaluran kerja diuraikan secara transparan tanpa pungutan tersembunyi."
          class="mb-12"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-sand/40 border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-sand text-[10px] font-heading font-bold uppercase tracking-wider text-brand-vermilion border border-brand-border">
                Pendidikan Lengkap
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                Pendidikan dari 0 s/d Persiapan Matching
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-charcoal">
                Rp 10.000.000
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                Mencakup 4 kelas: Kelas Pemula (dari nol), Kelas JFT, Kelas SSW, hingga Kelas Persiapan Matching / Kaiwa intensif bersama Native Speaker.
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> Untuk pemula tanpa dasar</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> Modul & CBT lengkap</li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-sand/40 border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-sand text-[10px] font-heading font-bold uppercase tracking-wider text-brand-vermilion border border-brand-border">
                Jalur Lanjutan
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                Masuk Kelas SSW / Persiapan Matching
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-charcoal">
                Rp 5.000.000
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                Bagi peserta yang <strong>sudah memiliki sertifikat JFT</strong>. Fokus langsung pada pendalaman materi ujian SSW dan simulasi wawancara user kerja.
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> Syarat: Sudah punya JFT</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> Durasi belajar lebih singkat</li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-porcelain border border-brand-border flex flex-col justify-between space-y-4 relative overflow-hidden">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-charcoal text-white text-[10px] font-heading font-bold uppercase tracking-wider">
                Matching Siswa Saindo
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                Matching Job Siswa Saindo
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-vermilion">
                Rp 31.000.000
              </div>
              <div class="inline-flex items-center gap-1 text-[11px] font-heading font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                ✓ Include Visa & Tiket Pesawat
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                Penyaluran kerja resmi langsung ke perusahaan mitra Jepang untuk siswa lulusan LPK Saindo.
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Pengurusan COE & Visa Kerja</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Tiket Pesawat Penerbangan</li>
            </ul>
          </div>

          <!-- Card 4 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-porcelain border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-stone text-white text-[10px] font-heading font-bold uppercase tracking-wider">
                Matching Siswa Luar / Mandiri
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                Matching Job Siswa Luar / Mandiri
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-charcoal">
                Rp 28.000.000
              </div>
              <div class="inline-flex items-center gap-1 text-[11px] font-heading font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                ✓ Include Visa & Tiket Pesawat
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                Terbuka bagi calon pekerja dari luar yang <strong>sudah mengantongi sertifikat JFT dan kelulusan SSW</strong>.
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> Syarat: Punya JFT & SSW</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> Sudah Include Visa & Tiket</li>
            </ul>
          </div>
        </div>
      </Container>
    </section>

    <!-- Program Cards Detailed List -->
    <section class="py-20 md:py-28 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="space-y-12">
          {programsData.map((item, index) => (
            <div class="card-shoji rounded-lg overflow-hidden border border-brand-border p-8 sm:p-10 flex flex-col lg:flex-row gap-8 lg:gap-12 items-center bg-white">
              
              <!-- Left Column: Media / Hero image -->
              <div class="w-full lg:w-5/12 aspect-[4/3] rounded bg-brand-sand overflow-hidden relative shrink-0">
                <img
                  src={item.heroImage}
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="absolute top-4 left-4">
                  <Badge variant={item.badge as any}>{item.badgeLabel}</Badge>
                </div>
              </div>

              <!-- Right Column: Details & Specs -->
              <div class="w-full lg:w-7/12 space-y-5">
                <div class="space-y-2">
                  <span class="text-xs font-heading font-semibold text-brand-vermilion uppercase tracking-wider">
                    {item.tagline}
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-charcoal leading-snug">
                    <a href={`/programs/${item.slug}`} class="hover:text-brand-vermilion transition-colors">
                      {item.title}
                    </a>
                  </h2>
                  <p class="text-sm sm:text-base font-body text-brand-slate leading-relaxed">
                    {item.description}
                  </p>
                </div>

                <!-- Pricing Highlight if present -->
                {item.pricing && (
                  <div class="p-3 rounded bg-brand-sand/60 border border-brand-border text-xs font-heading text-brand-charcoal">
                    <strong class="text-brand-vermilion uppercase tracking-wider block text-[11px] mb-0.5">Skema Pembiayaan:</strong>
                    <span>{item.pricing}</span>
                  </div>
                )}

                <!-- Specs Grid -->
                <div class="grid grid-cols-2 gap-4 pt-3 border-t border-brand-border/60 text-xs font-heading">
                  <div>
                    <span class="text-brand-stone font-medium">Estimasi Durasi:</span>
                    <p class="text-brand-charcoal font-bold mt-0.5">{item.duration}</p>
                  </div>
                  <div>
                    <span class="text-brand-stone font-medium">Target Kelulusan:</span>
                    <p class="text-brand-charcoal font-bold mt-0.5">{item.target}</p>
                  </div>
                </div>

                <!-- Action Button -->
                <div class="pt-4 flex flex-wrap items-center gap-4">
                  <Button variant="primary" size="md" href={`/programs/${item.slug}`}>
                    Lihat Silabus & Persyaratan Lengkap
                    <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                  </Button>
                  <Button
                    variant="outline"
                    size="md"
                    href={`https://wa.me/6282221046007?text=Halo%20LPK%20Saindo%2C%20saya%20tertarik%20dengan%20program%20${encodeURIComponent(item.title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Konsultasi Program Ini
                  </Button>
                </div>
              </div>

            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- Consultation CTA -->
    <section class="py-16 bg-brand-porcelain border-b border-brand-border">
      <Container>
        <div class="text-center max-w-2xl mx-auto space-y-4">
          <h2 class="text-2xl sm:text-3xl font-heading font-extrabold text-brand-charcoal">
            Bingung Memilih Jalur Program yang Sesuai?
          </h2>
          <p class="text-sm sm:text-base text-brand-slate font-body leading-relaxed">
            Konselor kami siap membantu menganalisis latar belakang pendidikan, sertifikat yang sudah dimiliki, dan target waktu Anda untuk merekomendasikan program paling efisien.
          </p>
          <div class="pt-2">
            <Button
              variant="primary"
              size="lg"
              href="https://wa.me/6282221046007?text=Halo%20LPK%20Saindo%2C%20saya%20butuh%20rekomendasi%20pemilihan%20program%20ke%20Jepang"
              target="_blank"
              rel="noopener noreferrer"
            >
              Hubungi Konselor Sekarang (WhatsApp)
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="id" />
</MainLayout>
