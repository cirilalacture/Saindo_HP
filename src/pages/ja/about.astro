---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import { leadershipAndStaff, facilitiesData } from '../../data/about';
---

<MainLayout
  title="私たちについて — LPK Saindo (インドネシア政府認定 送出機関)"
  description="LPK Saindoの組織概要：労働省認可の正規送出機関（SO）。日本人専任教員による徹底した日本語・マナー指導、充実の全寮制研修施設、受入企業様へのコンプライアンス遵守。"
  lang="ja"
>
  <Navbar currentLang="ja" />

  <main class="font-ja">
    <!-- Header Banner -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>送出機関概要</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">ABOUT US</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            日本企業とインドネシアの有望な若者を結ぶ、<br />
            信頼と実績の正規送出機関。
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            LPK Saindoは、インドネシア労働省認可（KEMNAKER RI）の公式送出機関として、技能実習生および特定技能人材の育成と派遣を行っています。「姿勢（Shisei）」と「間（Ma）」を重んじ、現場で即戦力となる自立した人材を送り出します。
          </p>
        </div>
      </Container>
    </section>

    <!-- Vision, Mission & Philosophy -->
    <section class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <div class="lg:col-span-5 space-y-6">
            <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
              教育理念・基本方針
            </span>
            <h2 class="text-3xl font-heading font-bold text-brand-charcoal leading-tight">
              「日本で信頼され、長く活躍できる人間力」の育成。
            </h2>
            <div class="p-6 rounded bg-brand-sand border border-brand-border space-y-2">
              <span class="text-xs font-heading font-bold text-brand-vermilion uppercase tracking-wider">
                理念：姿勢（SHISEI）と間（MA）
              </span>
              <p class="text-sm font-body text-brand-slate leading-relaxed">
                語学の習得だけでなく、正しい立ち居振る舞い、時間を守る規律、そして相手を思いやるコミュニケーションを寮生活を通じて叩き込みます。
              </p>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-6 text-brand-slate font-body text-base">
            <div class="border-l-2 border-brand-vermilion pl-6 space-y-2">
              <h3 class="text-xl font-heading font-bold text-brand-charcoal">ビジョン</h3>
              <p class="leading-relaxed">
                受入企業様・監理団体様から「Saindoの修了生なら安心だ」と選ばれ続ける、東南アジア最高峰の職業教育・送出プラットフォームを目指します。
              </p>
            </div>

            <div class="border-l-2 border-brand-charcoal pl-6 space-y-3 pt-4">
              <h3 class="text-xl font-heading font-bold text-brand-charcoal">私たちの約束（コンプライアンス）</h3>
              <ul class="space-y-2.5 list-disc pl-4 text-sm sm:text-base leading-relaxed">
                <li>不当な保証金の徴収やブローカーの介入を徹底排除した透明な募集・選考。</li>
                <li>日本人専任教員による、日本の製造・介護・建設現場で通用する「生きた日本語」の指導。</li>
                <li>「5S（整理・整頓・清掃・清潔・躾）」と「報連相（ほうれんそう）」の生活習慣化。</li>
                <li>在留資格申請（COE）から入国後の生活適応支援まで、日本側窓口と連携した迅速なフォロー。</li>
              </ul>
            </div>
          </div>

        </div>
      </Container>
    </section>

    <!-- Legalities & Accreditation -->
    <section class="py-16 bg-brand-porcelain border-b border-brand-border">
      <Container>
        <div class="p-8 sm:p-10 rounded-lg bg-white border border-brand-border shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div class="space-y-2 max-w-xl">
            <div class="inline-flex px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-heading font-semibold uppercase tracking-wider">
              公的認可・法令遵守
            </div>
            <h3 class="text-2xl font-heading font-bold text-brand-charcoal">
              インドネシア労働省 (KEMNAKER RI) 認定番号
            </h3>
            <p class="text-sm font-body text-brand-slate">
              インドネシアおよび日本の関連法規に基づき、外国人技能実習機構（OTIT）基準に完全に適合した運用を行っています。
            </p>
          </div>
          <div class="space-y-2 shrink-0 text-sm font-heading text-brand-charcoal">
            <p><span class="text-brand-stone font-medium">送出機関許可（SO）:</span> <strong class="text-brand-charcoal">KEMNAKER RI No. 2/XXX/HK.01/2022</strong></p>
            <p><span class="text-brand-stone font-medium">機関登録番号 (VIN):</span> <strong class="text-brand-charcoal">2209320401</strong></p>
            <p><span class="text-brand-stone font-medium">職業訓練校営業許可:</span> <strong class="text-brand-charcoal">DISNAKER No. 563/124-Disnaker/2018</strong></p>
          </div>
        </div>
      </Container>
    </section>

    <!-- Instructors -->
    <section class="py-20 md:py-28 bg-white border-b border-brand-border">
      <Container>
        <SectionHeader
          tagline="指導陣・講師"
          taglineJa="INSTRUCTORS"
          title="日本人教員と経験豊かな専任講師による徹底指導。"
          description="日本での勤務経験を持つ指導員とネイティブ講師がチームを組み、一人ひとりの学習習熟度に応じた親身な指導を行います。"
          class="mb-16"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {leadershipAndStaff.map((staff) => (
            <div class="card-shoji rounded overflow-hidden flex flex-col justify-between group">
              <div>
                <div class="aspect-[4/5] bg-brand-sand overflow-hidden relative">
                  <img
                    src={staff.image}
                    alt={staff.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute bottom-2.5 right-2.5 px-2.5 py-1 rounded bg-black/75 text-[11px] font-heading font-semibold text-white">
                    {staff.experience}
                  </div>
                </div>
                <div class="p-6 space-y-2">
                  <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug group-hover:text-brand-vermilion transition-colors">
                    {staff.name}
                  </h3>
                  <div class="text-xs font-heading font-semibold text-brand-vermilion uppercase tracking-wider">
                    {staff.roleJa}
                  </div>
                  <p class="text-xs font-body text-brand-slate leading-relaxed pt-1">
                    {staff.bioJa}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- Facilities -->
    <section class="py-20 md:py-28 bg-brand-porcelain border-b border-brand-border">
      <Container>
        <SectionHeader
          tagline="教育施設"
          taglineJa="FACILITIES"
          title="規律ある共同生活を支える充実の研修施設。"
          description="冷暖房完備の講義室、オンライン模擬試験対応のPC室、清潔な社員寮風の宿舎を完備しています。"
          class="mb-16"
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {facilitiesData.map((fac) => (
            <div class="card-shoji rounded overflow-hidden group bg-white">
              <div class="aspect-[16/9] bg-brand-sand overflow-hidden relative">
                <img
                  src={fac.image}
                  alt={fac.titleJa}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 sm:p-7 space-y-2">
                <h3 class="font-heading font-bold text-xl text-brand-charcoal leading-snug">
                  {fac.titleJa}
                </h3>
                <p class="text-sm font-body text-brand-slate leading-relaxed">
                  {fac.descJa}
                </p>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-white border-b border-brand-border">
      <Container>
        <div class="text-center max-w-2xl mx-auto space-y-6">
          <h2 class="text-3xl font-heading font-extrabold text-brand-charcoal">
            インドネシア人材の採用をご検討の企業様へ
          </h2>
          <p class="text-base text-brand-slate font-body">
            受入職種のご相談、現地面接のスケジュール、派遣までの所要期間など、日本語でお気軽にお問い合わせください。オンライン面談も随時承っております。
          </p>
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
            <Button
              variant="primary"
              size="lg"
              href="https://wa.me/628123456789?text=LPK%20Saindo%E6%A7%98%E3%80%81%E5%8F%97%E5%85%A5%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9B%B8%E8%AB%87%E3%81%97%E3%81%9F%E3%81%8F%E9%80%A3%E7%B5%A1%E3%81%84%E3%81%9F%E3%81%97%E3%81%BE%E3%81%97%E3%81%9F%E3%80%82"
              target="_blank"
              rel="noopener noreferrer"
            >
              日本語で問い合わせる (WhatsApp)
            </Button>
            <Button variant="outline" size="lg" href="/ja/contact">
              お問い合わせフォーム
            </Button>
          </div>
        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="ja" />
</MainLayout>
