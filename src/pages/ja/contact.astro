---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { getAllSettings } from '../../db/queries/settings';

const db = Astro.locals.runtime?.env?.DB;
let settings: Record<string, string> = {};
if (db) {
  try {
    settings = await getAllSettings(db);
  } catch (err) {
    console.error('Failed to load contact settings:', err);
  }
}

const address = settings.address_ja || settings.address_id || 'Jl. Pendidikan Kejuruan No. 88, Cibinong, Bogor, Jawa Barat 16911, Indonesia';
const whatsapp = settings.whatsapp_number || '628123456789';
const email = settings.contact_email || 'info@lpksaindo.com';
const workingHours = settings.working_hours_ja || '月曜日〜金曜日: 08:00〜17:00 (WIB) / 日本時間 10:00〜19:00';
---

<MainLayout
  title="お問い合わせ — LPK Saindo (受入企業・監理団体様向け窓口)"
  description="LPK Saindoの受入ご相談・お問い合わせ窓口。技能実習生・特定技能外国人の採用、求人票の受付、現地面接の調整など、日本語で対応いたします。"
  lang="ja"
>
  <Navbar currentLang="ja" />

  <main class="font-ja">
    <!-- Header Banner -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>CONTACT US</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">お問い合わせ窓口</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            インドネシア人材の採用・受入れに関するご相談。
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            職種別の採用要件、教育カリキュラムのカスタマイズ、オンライン面談の調整など、日本人専任担当者が丁寧にご案内いたします。
          </p>
        </div>
      </Container>
    </section>

    <!-- Contact Info & Form -->
    <section class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-3">
              <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
                機関情報・研修センター所在地
              </span>
              <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-charcoal">
                LPK Saindo 本部施設
              </h2>
            </div>

            <div class="space-y-6 text-sm font-body text-brand-slate">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">所在地：</h3>
                  <p class="mt-1 leading-relaxed">
                    {address}
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">日本語対応ホットライン：</h3>
                  <p class="mt-1 leading-relaxed">
                    <a href={`https://wa.me/${whatsapp}`} class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      +{whatsapp}
                    </a>（WhatsApp・通話対応）
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">代表Eメール：</h3>
                  <p class="mt-1 leading-relaxed">
                    <a href={`mailto:${email}`} class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      {email}
                    </a>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">営業時間：</h3>
                  <p class="mt-1 leading-relaxed">
                    {workingHours}
                  </p>
                </div>
              </div>
            </div>

            <div class="p-6 rounded bg-brand-porcelain border border-brand-border space-y-3">
              <span class="text-xs font-heading font-bold text-brand-charcoal uppercase tracking-wider">
                オンライン面談のご予約
              </span>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                ZoomまたはGoogle Meetによるオンライン相談も随時受け付けております。
              </p>
              <Button
                variant="primary"
                size="md"
                href="https://wa.me/628123456789?text=LPK%20Saindo%E6%A7%98%E3%80%81%E3%82%AA%E3%83%B3%E3%83%A9%E3%82%A4%E3%83%B3%E9%9D%A2%E8%AB%87%E3%81%AE%E4%BA%88%E7%B4%84%E3%82%92%E5%B8%8C%E6%9C%9B%E3%81%84%E3%81%9F%E3%81%97%E3%81%BE%E3%81%97%E3%81%9F%E3%80%82"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full"
              >
                WhatsAppで面談予約する
              </Button>
            </div>
          </div>

          <div class="lg:col-span-7 card-shoji rounded-lg border border-brand-border bg-white p-8 sm:p-10 shadow-sm space-y-6">
            <div class="space-y-2">
              <h3 class="text-2xl font-heading font-bold text-brand-charcoal">
                お問い合わせフォーム
              </h3>
              <p class="text-sm font-body text-brand-slate">
                以下の項目をご入力の上、送信してください。担当者より速やかにご返信いたします。
              </p>
            </div>

            <form
              action="https://wa.me/628123456789"
              method="GET"
              target="_blank"
              class="space-y-5"
            >
              <div>
                <label for="company" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                  貴社名・監理団体名 *
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  placeholder="例：株式会社〇〇 / 〇〇協同組合"
                  class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="contact_name" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                    ご担当者様氏名 *
                  </label>
                  <input
                    type="text"
                    id="contact_name"
                    name="contact_name"
                    required
                    placeholder="例：山田 太郎"
                    class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                  />
                </div>
                <div>
                  <label for="category" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                    ご検討の受入区分 *
                  </label>
                  <select
                    id="category"
                    name="category"
                    class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                  >
                    <option value="特定技能1号の採用">特定技能1号の採用</option>
                    <option value="技能実習生の受入れ">技能実習生の受入れ</option>
                    <option value="教育カリキュラムの視察・提携">現地視察・提携について</option>
                    <option value="その他">その他のお問い合わせ</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="inquiry" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                  お問い合わせ内容・希望職種・人数等 *
                </label>
                <textarea
                  id="inquiry"
                  name="inquiry"
                  rows="4"
                  required
                  placeholder="ご希望の職種、必要人数、面接予定時期などをご記入ください..."
                  class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors resize-none"
                ></textarea>
              </div>

              <Button
                type="submit"
                variant="primary"
                size="lg"
                class="w-full"
              >
                お問い合わせ内容を送信する
              </Button>
            </form>
          </div>

        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="ja" />
</MainLayout>
