---
import MainLayout from '../../../layouts/MainLayout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import Container from '../../../components/ui/Container.astro';
import { getPublishedAlbums, type AlbumListItem } from '../../../db/queries/gallery';

let albums: AlbumListItem[] = [];
const db = Astro.locals.runtime?.env?.DB;

if (db) {
  try {
    albums = await getPublishedAlbums(db);
  } catch (err) {
    console.error('Failed to fetch albums from D1:', err);
  }
}
---

<MainLayout
  title="活動ギャラリー — LPK Saindo (研修風景・壮行会・生活記録)"
  description="LPK Saindoの教育活動フォトギャラリー：日本語講義、実践会話（Kaiwa）、特定技能実技訓練、日本渡航壮行式の記録。"
  lang="ja"
>
  <Navbar currentLang="ja" />

  <main class="font-ja">
    <!-- Banner Header -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>GALLERY</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">活動記録</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            Saindoの研修現場・日々の成長記録。
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            真剣な面持ちで取り組む授業風景、日本人教員との活気ある対話、そして日本へと旅立つ修了生の晴れやかな表情をご覧ください。
          </p>
        </div>
      </Container>
    </section>

    <!-- Album Grid -->
    <section class="py-20 md:py-28 bg-white border-b border-brand-border">
      <Container>
        {albums.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {albums.map((album) => (
              <a
                href={`/ja/gallery/${album.slug}`}
                class="card-shoji rounded-lg overflow-hidden group bg-white border border-brand-border p-3 flex flex-col justify-between"
              >
                <div>
                  <div class="aspect-[4/3] rounded bg-brand-sand overflow-hidden relative">
                    <img
                      src={album.coverUrl || 'https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&fit=crop&w=800&q=80'}
                      alt={album.titleJa || album.titleId}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute bottom-3 right-3 px-3 py-1 rounded-full bg-black/75 text-white text-[11px] font-heading font-semibold flex items-center gap-1.5 shadow-sm">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <span>{album.itemCount} 枚</span>
                    </div>
                  </div>

                  <div class="p-4 space-y-2">
                    {album.eventDate && (
                      <span class="text-xs font-heading font-medium text-brand-stone">
                        実施日：{album.eventDate}
                      </span>
                    )}
                    <h2 class="font-heading font-bold text-lg text-brand-charcoal leading-snug group-hover:text-brand-vermilion transition-colors">
                      {album.titleJa || album.titleId}
                    </h2>
                    {(album.descriptionJa || album.descriptionId) && (
                      <p class="text-xs font-body text-brand-slate line-clamp-2 leading-relaxed">
                        {album.descriptionJa || album.descriptionId}
                      </p>
                    )}
                  </div>
                </div>

                <div class="px-4 pb-3 pt-2 border-t border-brand-border/60 text-xs font-heading font-semibold text-brand-charcoal group-hover:text-brand-vermilion inline-flex items-center">
                  アルバムを開く <span class="ml-1">→</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-brand-porcelain rounded border border-brand-border">
            <p class="text-base text-brand-slate font-heading">公開中のアルバムはありません。</p>
          </div>
        )}
      </Container>
    </section>
  </main>

  <Footer currentLang="ja" />
</MainLayout>
