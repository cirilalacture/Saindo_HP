---
import MainLayout from '../../../layouts/MainLayout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import Container from '../../../components/ui/Container.astro';
import Badge from '../../../components/ui/Badge.astro';
import Button from '../../../components/ui/Button.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import { programsData } from '../../../data/programs';
---

<MainLayout
  title="研修プログラム・料金一覧 — LPK Saindo (Saindo Passion Global)"
  description="LPK Saindoの教育プログラムおよび費用体系一覧：特定技能（SSW）、技人国（エンジニア）、4段階集中コース、外部有資格者向けマッチング支援（ビザ・航空券込）。"
  lang="ja"
>
  <Navbar currentLang="ja" />

  <main class="font-ja">
    <!-- Banner Header -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>PROGRAMS & TUITION</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">研修プログラム・費用一覧</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            日本の産業界が求める実践的教育とマッチング。
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            LPK Saindo（Saindo Passion Global）は、特定技能（SSW）および技術・人文知識・国際業務（エンジニア）に特化し、透明性の高い費用体系と手厚い就労マッチングを提供しています。
          </p>
        </div>
      </Container>
    </section>

    <!-- Transparent Pricing Matrix Section (JA) -->
    <section class="py-16 bg-white border-b border-brand-border">
      <Container>
        <SectionHeader
          tagline="料金の透明性"
          taglineJa="TRANSPARENT TUITION"
          title="明確でオープンな費用体系"
          description="不透明な追加費用やブローカー手数料を一切排除した安心の料金プランです。"
          class="mb-12"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-sand/40 border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-sand text-[10px] font-heading font-bold uppercase tracking-wider text-brand-vermilion border border-brand-border">
                ゼロからの総合講習
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                基礎から面接対策まで
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-charcoal">
                1,000万 ルピア
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                初心者クラス（文字・文法）、JFT対策、特定技能試験対策、面接直前カイワまで全4段階を含む一貫パッケージ。
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> 未経験者・初学者向け</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> 教材・CBT模擬試験込</li>
            </ul>
          </div>

          <!-- Card 2 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-sand/40 border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-sand text-[10px] font-heading font-bold uppercase tracking-wider text-brand-vermilion border border-brand-border">
                有資格者ステップ参加
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                特定技能・面接対策から参加
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-charcoal">
                500万 ルピア
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                <strong>既にJFT-Basic A2を取得済</strong>の方向け。特定技能分野の専門実技対策および企業面接カイワに特化。
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> 条件：JFT合格証保持</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> 短期集中型カリキュラム</li>
            </ul>
          </div>

          <!-- Card 3 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-porcelain border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-charcoal text-white text-[10px] font-heading font-bold uppercase tracking-wider">
                在校・修了生向け
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                Saindo生徒マッチング
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-vermilion">
                3,100万 ルピア
              </div>
              <div class="inline-flex items-center gap-1 text-[11px] font-heading font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                ✓ 査証＋渡航航空券込み
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                LPK Saindo在校生・修了生向けの企業選考、内定獲得、ビザ申請、渡航手続きの全工程包括サポート。
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> COE・就労ビザ取得代行</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> 日本行き航空券手配</li>
            </ul>
          </div>

          <!-- Card 4 -->
          <div class="card-shoji rounded-lg p-6 bg-brand-porcelain border border-brand-border flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <span class="inline-block px-2.5 py-1 rounded bg-brand-stone text-white text-[10px] font-heading font-bold uppercase tracking-wider">
                外部一般・有資格者
              </span>
              <h3 class="font-heading font-bold text-lg text-brand-charcoal leading-snug">
                外部有資格者マッチング
              </h3>
              <div class="text-2xl font-heading font-extrabold text-brand-charcoal">
                2,800万 ルピア
              </div>
              <div class="inline-flex items-center gap-1 text-[11px] font-heading font-bold text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded">
                ✓ 査証＋渡航航空券込み
              </div>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                外部の一般応募者で、<strong>既にJFTおよび特定技能評価試験に合格している方</strong>への企業求人直結支援。
              </p>
            </div>
            <ul class="text-[11px] font-body text-brand-stone space-y-1 pt-3 border-t border-brand-border/60">
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> 条件：JFT & SSW合格済</li>
              <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-vermilion"></span> 査証・渡航航空券込み</li>
            </ul>
          </div>
        </div>
      </Container>
    </section>

    <!-- Program Cards -->
    <section class="py-20 md:py-28 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="space-y-12">
          {programsData.map((item, index) => (
            <div class="card-shoji rounded-lg overflow-hidden border border-brand-border p-8 sm:p-10 flex flex-col lg:flex-row gap-8 lg:gap-12 items-center bg-white">
              
              <div class="w-full lg:w-5/12 aspect-[4/3] rounded bg-brand-sand overflow-hidden relative shrink-0">
                <img
                  src={item.heroImage}
                  alt={item.titleJa}
                  class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                <div class="absolute top-4 left-4">
                  <Badge variant={item.badge as any}>{item.badgeLabelJa}</Badge>
                </div>
              </div>

              <div class="w-full lg:w-7/12 space-y-5">
                <div class="space-y-2">
                  <span class="text-xs font-heading font-semibold text-brand-vermilion uppercase tracking-wider">
                    {item.taglineJa}
                  </span>
                  <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-charcoal leading-snug">
                    <a href={`/ja/programs/${item.slug}`} class="hover:text-brand-vermilion transition-colors">
                      {item.titleJa}
                    </a>
                  </h2>
                  <p class="text-sm sm:text-base font-body text-brand-slate leading-relaxed">
                    {item.descriptionJa}
                  </p>
                </div>

                {item.pricingJa && (
                  <div class="p-3 rounded bg-brand-sand/60 border border-brand-border text-xs font-heading text-brand-charcoal">
                    <strong class="text-brand-vermilion uppercase tracking-wider block text-[11px] mb-0.5">費用体系：</strong>
                    <span>{item.pricingJa}</span>
                  </div>
                )}

                <div class="grid grid-cols-2 gap-4 pt-3 border-t border-brand-border/60 text-xs font-heading">
                  <div>
                    <span class="text-brand-stone font-medium">標準講習期間:</span>
                    <p class="text-brand-charcoal font-bold mt-0.5">{item.durationJa}</p>
                  </div>
                  <div>
                    <span class="text-brand-stone font-medium">到達目標:</span>
                    <p class="text-brand-charcoal font-bold mt-0.5">{item.targetJa}</p>
                  </div>
                </div>

                <div class="pt-4 flex flex-wrap items-center gap-4">
                  <Button variant="primary" size="md" href={`/ja/programs/${item.slug}`}>
                    カリキュラム詳細を見る
                    <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                  </Button>
                  <Button
                    variant="outline"
                    size="md"
                    href={`https://wa.me/6282221046007?text=LPK%20Saindo%E6%A7%98%E3%80%81${encodeURIComponent(item.titleJa)}%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9B%B8%E8%AB%87%E3%81%97%E3%81%9F%E3%81%8F%E9%80%A3%E7%B5%A1%E3%81%84%E3%81%9F%E3%81%97%E3%81%BE%E3%81%97%E3%81%9F%E3%80%82`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    このプログラムについて相談する
                  </Button>
                </div>
              </div>

            </div>
          ))}
        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="ja" />
</MainLayout>
