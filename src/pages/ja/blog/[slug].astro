---
import MainLayout from '../../../layouts/MainLayout.astro';
import Navbar from '../../../components/layout/Navbar.astro';
import Footer from '../../../components/layout/Footer.astro';
import Container from '../../../components/ui/Container.astro';
import Button from '../../../components/ui/Button.astro';
import TipTapRenderer from '../../../components/blog/TipTapRenderer.astro';
import { getPostBySlug } from '../../../db/queries/posts';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

let postData: any = null;

if (db && slug) {
  try {
    postData = await getPostBySlug(db, slug);
  } catch (err) {
    console.error('Failed to query post from D1:', err);
  }
}

if (!postData) {
  return Astro.redirect('/ja/blog');
}

const { post, cover, author, category } = postData;
const title = post.titleJa || post.titleId;
const excerpt = post.excerptJa || post.excerptId;
const hasJapaneseContent = Boolean(post.contentJa && post.contentJa.trim().length > 15);
const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('ja-JP', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<MainLayout
  title={`${title} — お知らせ LPK Saindo`}
  description={post.metaDescriptionJa || excerpt}
  lang="ja"
>
  <Navbar currentLang="ja" />

  <main class="font-ja">
    <!-- Article Header -->
    <header class="py-16 md:py-20 bg-[#FAFAF8] border-b border-brand-border">
      <Container class="max-w-4xl">
        <div class="space-y-5">
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-heading font-medium text-brand-stone">
            <a href="/ja" class="hover:text-brand-charcoal transition-colors">ホーム</a>
            <span>/</span>
            <a href="/ja/blog" class="hover:text-brand-charcoal transition-colors">お知らせ</a>
            {category && (
              <>
                <span>/</span>
                <span class="text-brand-charcoal font-semibold">{category.nameJa || category.nameId}</span>
              </>
            )}
          </nav>

          <div class="space-y-4">
            {category && (
              <span class="inline-block px-3 py-1 rounded-full bg-brand-sand border border-brand-border text-xs font-heading font-bold uppercase tracking-wider text-brand-vermilion">
                {category.nameJa || category.nameId}
              </span>
            )}

            <h1 class="text-3xl sm:text-4xl lg:text-[44px] font-heading font-extrabold text-brand-charcoal tracking-tight leading-[1.18]">
              {title}
            </h1>

            <p class="text-lg text-brand-slate font-body leading-relaxed">
              {excerpt}
            </p>

            <div class="flex items-center gap-4 pt-4 border-t border-brand-border/80 text-xs font-heading text-brand-stone">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-vermilion"></span>
                <span class="text-brand-charcoal font-semibold">{author?.name || 'LPK Saindo 事務局'}</span>
              </div>
              <span>•</span>
              <time datetime={post.publishedAt}>{formattedDate}</time>
              <span>•</span>
              <span>読了目安：約3分</span>
            </div>
          </div>
        </div>
      </Container>
    </header>

    <!-- Article Content -->
    <article class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container class="max-w-3xl">
        {cover?.displayUrl && (
          <div class="mb-12 rounded-lg overflow-hidden border border-brand-border bg-brand-sand shadow-sm">
            <img
              src={cover.displayUrl}
              alt={title}
              class="w-full h-auto max-h-[500px] object-cover"
              loading="eager"
            />
          </div>
        )}

        {hasJapaneseContent ? (
          <TipTapRenderer contentJson={post.contentJa} />
        ) : (
          <div class="p-8 rounded border border-brand-border bg-brand-sand/30 text-center space-y-4 my-8">
            <span class="text-xs font-heading font-bold text-brand-vermilion uppercase tracking-widest">
              日本語版準備中 / TRANSLATION IN PROGRESS
            </span>
            <p class="text-sm font-body text-brand-slate max-w-lg mx-auto">
              この記事の日本語詳細翻訳は現在準備中です。インドネシア語の原文記事をご覧いただくか、直接担当者までお問い合わせください。
            </p>
            <div class="pt-2 flex justify-center gap-4">
              <Button variant="outline" size="sm" href={`/blog/${post.slug}`}>
                インドネシア語の原文を読む
              </Button>
            </div>
          </div>
        )}

        <div class="mt-16 pt-8 border-t border-brand-border flex flex-col sm:flex-row items-center justify-between gap-4">
          <Button variant="outline" size="md" href="/ja/blog">
            ← お知らせ一覧へ戻る
          </Button>

          <Button
            variant="ghost"
            size="md"
            href={`https://wa.me/6282221046007?text=LPK%20Saindo%E6%A7%98%E3%80%81${encodeURIComponent(title)}%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6`}
            target="_blank"
            rel="noopener noreferrer"
          >
            この記事について問い合わせる ↗
          </Button>
        </div>
      </Container>
    </article>
  </main>

  <Footer currentLang="ja" />
</MainLayout>
