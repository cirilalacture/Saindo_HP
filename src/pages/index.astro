---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<MainLayout title="LPK Saindo — Mempersiapkan Karier Menuju Jepang" lang="id">
  <Navbar currentLang="id" />

  <main>
    <!-- SECTION 02: HERO -->
    <section class="relative overflow-hidden pt-12 pb-20 md:py-28 bg-[#FAFAF8] border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          
          <!-- Left Editorial Copy -->
          <div class="lg:col-span-7 space-y-8">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-sand border border-brand-border text-[11px] font-heading font-semibold tracking-wider text-brand-charcoal uppercase">
              <span class="w-2 h-2 rounded-full bg-brand-vermilion"></span>
              Lembaga Pelatihan Resmi Magang & Tokutei Ginou
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-heading font-extrabold text-brand-charcoal leading-[1.12] tracking-tight">
              Masa Depanmu Dimulai dari Sini. <span class="text-brand-vermilion">Melangkah Bersama Saindo</span> Menuju Jepang.
            </h1>

            <p class="text-lg text-brand-slate font-body leading-relaxed max-w-2xl">
              Persiapkan kemampuan bahasa Jepang intensif, keterampilan kerja spesifik, dan mentalitas profesional untuk membangun karier gemilang di Jepang secara legal, terstruktur, dan terpercaya.
            </p>

            <!-- Dual Action CTAs -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
              <a
                href="https://wa.me/628123456789?text=Halo%20LPK%20Saindo%2C%20saya%20tertarik%20mendaftar%20pelatihan%20ke%20Jepang"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-8 py-3.5 rounded bg-brand-vermilion text-white font-heading font-semibold text-sm tracking-wide hover:bg-brand-crimson transition-all shadow-sm active:scale-[0.98]"
              >
                Daftar Sekarang
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>

              <a
                href="#programs"
                class="inline-flex items-center justify-center px-7 py-3.5 rounded border border-brand-charcoal text-brand-charcoal font-heading font-semibold text-sm tracking-wide hover:bg-brand-charcoal hover:text-white transition-all active:scale-[0.98]"
              >
                Pelajari Program
              </a>
            </div>

            <!-- Mini Trust Badges -->
            <div class="pt-6 border-t border-brand-border/70 flex flex-wrap items-center gap-6 text-xs text-brand-slate font-heading">
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Izin SO Kemenaker RI</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Native Speaker & Instruktur Bersertifikat</span>
              </div>
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
                <span>Fasilitas Lengkap & Asrama</span>
              </div>
            </div>
          </div>

          <!-- Right Hero Visual Card -->
          <div class="lg:col-span-5 relative">
            <div class="relative rounded-lg overflow-hidden border border-brand-border bg-white p-3 shadow-sm">
              <div class="aspect-[4/3] rounded bg-brand-sand overflow-hidden relative group">
                <img
                  src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80"
                  alt="Siswa LPK Saindo sedang belajar di ruang kelas bahasa Jepang"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end p-6">
                  <div class="text-white">
                    <span class="text-xs font-heading font-semibold uppercase tracking-widest text-brand-sand">Dokumentasi Pelatihan</span>
                    <p class="text-sm font-heading font-medium mt-1">Kelas Intensif Bahasa & Kedisiplinan Kerja Jepang</p>
                  </div>
                </div>
              </div>

              <!-- Floating Stat Pill -->
              <div class="absolute -bottom-4 -left-4 bg-brand-charcoal text-white px-5 py-3 rounded border border-white/20 shadow-lg hidden sm:flex items-center gap-3">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
                <div>
                  <div class="text-[11px] font-heading text-gray-300">Pendaftaran Angkatan Baru</div>
                  <div class="text-sm font-heading font-bold text-white">Gelombang Terbuka — Kuota Terbatas</div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 03 & 04: TRUST INDICATORS & INTRODUCTION -->
    <section class="py-16 md:py-24 bg-white border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Metrics Row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 pb-16 border-b border-brand-border">
          <div class="border-l-2 border-brand-vermilion pl-5">
            <div class="text-4xl lg:text-5xl font-heading font-extrabold text-brand-charcoal">500+</div>
            <div class="text-xs sm:text-sm font-heading text-brand-slate mt-1 font-medium">Alumni Berangkat ke Jepang</div>
          </div>
          <div class="border-l-2 border-brand-vermilion pl-5">
            <div class="text-4xl lg:text-5xl font-heading font-extrabold text-brand-charcoal">98%</div>
            <div class="text-xs sm:text-sm font-heading text-brand-slate mt-1 font-medium">Tingkat Kelulusan JLPT & JFT</div>
          </div>
          <div class="border-l-2 border-brand-vermilion pl-5">
            <div class="text-4xl lg:text-5xl font-heading font-extrabold text-brand-charcoal">35+</div>
            <div class="text-xs sm:text-sm font-heading text-brand-slate mt-1 font-medium">Mitra Asosiasi (AO / Kumiai)</div>
          </div>
          <div class="border-l-2 border-brand-vermilion pl-5">
            <div class="text-4xl lg:text-5xl font-heading font-extrabold text-brand-charcoal">8+</div>
            <div class="text-xs sm:text-sm font-heading text-brand-slate mt-1 font-medium">Tahun Pengalaman Pembinaan</div>
          </div>
        </div>

        <!-- Introduction Editorial Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-16 items-center">
          <div class="lg:col-span-5 space-y-4">
            <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
              TENTANG LEMBAGA / 私たちについて
            </span>
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-brand-charcoal leading-tight">
              Mempersiapkan Generasi Muda Berintegritas & Siap Kerja di Jepang.
            </h2>
          </div>
          <div class="lg:col-span-7 space-y-5 text-brand-slate font-body text-base leading-relaxed">
            <p>
              LPK Saindo didirikan dengan tekad mulia: menjembatani potensi anak muda Indonesia dengan standar disiplin dan etos kerja industri di Jepang. Kami menerapkan metode pendidikan holistik berprinsip <em>Shisei</em> (ketegasan & integritas).
            </p>
            <p>
              Bukan sekadar mengajarkan kosakata bahasa Jepang, kami menanamkan kebiasaan 5S (Seiri, Seiton, Seiso, Seiketsu, Shitsuke), budaya komunikasi kerja <em>Horenso</em>, serta ketahanan fisik dan mental yang membuat lulusan Saindo disegani oleh rekanan perusahaan di Jepang.
            </p>
            <div class="pt-2">
              <a href="/about" class="inline-flex items-center text-sm font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion transition-colors">
                Baca Profil Lengkap & Legalitas Lembaga
                <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 05: PROGRAMS -->
    <section id="programs" class="py-20 md:py-28 bg-[#FAFAF8] border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-2xl mb-16 space-y-3">
          <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            PROGRAM PELATIHAN / 研修プログラム
          </span>
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-brand-charcoal tracking-tight">
            Pilih Jalur Keberangkatan Sesuai Minat & Tujuan Kariermu.
          </h2>
          <p class="text-base text-brand-slate font-body">
            Kurikulum kami disesuaikan langsung dengan syarat kelulusan sertifikasi resmi dan standar kebutuhan industri di Jepang.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Program 1 -->
          <div class="bg-white rounded p-6 border border-brand-border card-hover-effect flex flex-col justify-between">
            <div class="space-y-4">
              <div class="inline-flex px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-heading font-semibold uppercase tracking-wider">
                Bahasa Jepang
              </div>
              <h3 class="text-xl font-heading font-bold text-brand-charcoal leading-snug">
                Kursus Intensif JLPT & JFT-Basic
              </h3>
              <p class="text-sm text-brand-slate font-body leading-relaxed">
                Pembelajaran akselerasi dari dasar hiragana/katakana hingga target JLPT N4/N3 dan JFT-Basic A2 dengan simulasi soal rutin.
              </p>
            </div>
            <div class="pt-6 border-t border-brand-border/60 mt-6">
              <a href="/programs/bahasa-jepang" class="text-xs font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion inline-flex items-center">
                Lihat Silabus <span class="ml-1">→</span>
              </a>
            </div>
          </div>

          <!-- Program 2 -->
          <div class="bg-white rounded p-6 border border-brand-border card-hover-effect flex flex-col justify-between">
            <div class="space-y-4">
              <div class="inline-flex px-2.5 py-1 rounded-full bg-red-50 text-red-800 border border-red-200 text-[11px] font-heading font-semibold uppercase tracking-wider">
                Tokutei Ginou
              </div>
              <h3 class="text-xl font-heading font-bold text-brand-charcoal leading-snug">
                Specified Skilled Worker (SSW)
              </h3>
              <p class="text-sm text-brand-slate font-body leading-relaxed">
                Pelatihan keahlian kerja spesifik: Pengolahan Makanan, Pertanian, Perhotelan, dan Kaigo (Perawat Lansia) dengan kontrak kerja resmi.
              </p>
            </div>
            <div class="pt-6 border-t border-brand-border/60 mt-6">
              <a href="/programs/tokutei-ginou" class="text-xs font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion inline-flex items-center">
                Lihat Bidang Kerja <span class="ml-1">→</span>
              </a>
            </div>
          </div>

          <!-- Program 3 -->
          <div class="bg-white rounded p-6 border border-brand-border card-hover-effect flex flex-col justify-between">
            <div class="space-y-4">
              <div class="inline-flex px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-800 border border-indigo-200 text-[11px] font-heading font-semibold uppercase tracking-wider">
                Ginou Jisshuusei
              </div>
              <h3 class="text-xl font-heading font-bold text-brand-charcoal leading-snug">
                Program Pemagangan Industri
              </h3>
              <p class="text-sm text-brand-slate font-body leading-relaxed">
                Program magang kerja 3–5 tahun di perusahaan manufaktur, konstruksi, dan otomotif terkemuka di berbagai prefektur Jepang.
              </p>
            </div>
            <div class="pt-6 border-t border-brand-border/60 mt-6">
              <a href="/programs/magang-jepang" class="text-xs font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion inline-flex items-center">
                Lihat Prosedur <span class="ml-1">→</span>
              </a>
            </div>
          </div>

          <!-- Program 4 -->
          <div class="bg-white rounded p-6 border border-brand-border card-hover-effect flex flex-col justify-between">
            <div class="space-y-4">
              <div class="inline-flex px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200 text-[11px] font-heading font-semibold uppercase tracking-wider">
                Simulasi Seleksi
              </div>
              <h3 class="text-xl font-heading font-bold text-brand-charcoal leading-snug">
                Bimbingan Wawancara & Etika Kerja
              </h3>
              <p class="text-sm text-brand-slate font-body leading-relaxed">
                Mentoring langsung menghadapi pewawancara native dari Jepang (Menseki), pembuatan berkas riwayat hidup (Rirekisho), dan etika kerja.
              </p>
            </div>
            <div class="pt-6 border-t border-brand-border/60 mt-6">
              <a href="/programs/simulasi-wawancara" class="text-xs font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion inline-flex items-center">
                Pelajari Tips <span class="ml-1">→</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION 06: WHY SAINDO (SPLIT EDITORIAL) -->
    <section class="py-20 md:py-28 bg-white border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-6 relative">
            <div class="rounded overflow-hidden border border-brand-border bg-brand-sand aspect-[4/3] relative">
              <img
                src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1200&q=80"
                alt="Fasilitas pelatihan modern LPK Saindo"
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-6 space-y-6">
            <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
              KEUNGGULAN KAMI / なぜ私たちを選ぶのか
            </span>
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-brand-charcoal leading-tight">
              Mengapa Memilih LPK Saindo Sebagai Mitra Menuju Jepang?
            </h2>
            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center font-heading font-bold text-sm shrink-0 mt-0.5">
                  01
                </div>
                <div>
                  <h4 class="font-heading font-bold text-base text-brand-charcoal">Legalitas Terdaftar & Transparan</h4>
                  <p class="text-sm font-body text-brand-slate mt-1">Berizin resmi Kementerian Ketenagakerjaan RI sebagai Sending Organization (SO). Tidak ada pungutan liar atau janji palsu.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center font-heading font-bold text-sm shrink-0 mt-0.5">
                  02
                </div>
                <div>
                  <h4 class="font-heading font-bold text-base text-brand-charcoal">Sensei Bersertifikat & Native Speaker</h4>
                  <p class="text-sm font-body text-brand-slate mt-1">Instruktur lulusan sastra Jepang dan mantan praktisi kerja di Jepang, didukung oleh native speaker untuk latihan percakapan (kaiwa).</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center font-heading font-bold text-sm shrink-0 mt-0.5">
                  03
                </div>
                <div>
                  <h4 class="font-heading font-bold text-base text-brand-charcoal">Jaringan Mitra Kumiai & Perusahaan Luas</h4>
                  <p class="text-sm font-body text-brand-slate mt-1">Kerja sama langsung dengan puluhan organisasi pengawas dan perusahaan di Tokyo, Osaka, Nagoya, Hiroshima, dan Hokkaido.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-8 h-8 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center font-heading font-bold text-sm shrink-0 mt-0.5">
                  04
                </div>
                <div>
                  <h4 class="font-heading font-bold text-base text-brand-charcoal">Pendampingan Penuh Hingga Tiba di Jepang</h4>
                  <p class="text-sm font-body text-brand-slate mt-1">Kami mengawal pengurusan dokumen COE, visa kerja, tiket pesawat, hingga penjemputan dan monitoring adaptasi di Jepang.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 07: LEARNING JOURNEY TIMELINE -->
    <section class="py-20 md:py-28 bg-[#FAFAF8] border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
          <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            ALUR PERJALANAN / 出発までの流れ
          </span>
          <h2 class="text-3xl sm:text-4xl font-heading font-bold text-brand-charcoal">
            5 Langkah Mudah Menuju Karier Impian di Jepang.
          </h2>
          <p class="text-base text-brand-slate font-body">
            Proses terukur, transparan, dan terarah dari awal pendaftaran hingga mendarat di bandara Jepang.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-6 relative">
          
          <div class="bg-white rounded p-6 border border-brand-border relative">
            <div class="text-brand-vermilion font-heading font-black text-2xl mb-3">01</div>
            <h4 class="font-heading font-bold text-base text-brand-charcoal">Pendaftaran & Tes Fisik</h4>
            <p class="text-xs font-body text-brand-slate mt-2 leading-relaxed">
              Konsultasi minat bakat, tes kesehatan dasar (medical check up), dan verifikasi kelengkapan berkas administrasi.
            </p>
          </div>

          <div class="bg-white rounded p-6 border border-brand-border relative">
            <div class="text-brand-vermilion font-heading font-black text-2xl mb-3">02</div>
            <h4 class="font-heading font-bold text-base text-brand-charcoal">Pendidikan Bahasa</h4>
            <p class="text-xs font-body text-brand-slate mt-2 leading-relaxed">
              Pelatihan intensif 3–4 bulan di asrama, materi tata bahasa, kaiwa, kanji, dan ujian sertifikasi JLPT/JFT.
            </p>
          </div>

          <div class="bg-white rounded p-6 border border-brand-border relative">
            <div class="text-brand-vermilion font-heading font-black text-2xl mb-3">03</div>
            <h4 class="font-heading font-bold text-base text-brand-charcoal">Pelatihan Skill & Etika</h4>
            <p class="text-xs font-body text-brand-slate mt-2 leading-relaxed">
              Praktik keahlian sesuai bidang SSW/magang, pembentukan mental kedisiplinan kerja, dan latihan simulasi wawancara.
            </p>
          </div>

          <div class="bg-white rounded p-6 border border-brand-border relative">
            <div class="text-brand-vermilion font-heading font-black text-2xl mb-3">04</div>
            <h4 class="font-heading font-bold text-base text-brand-charcoal">Wawancara Perusahaan</h4>
            <p class="text-xs font-body text-brand-slate mt-2 leading-relaxed">
              Pelaksanaan wawancara kerja langsung dengan pimpinan perusahaan Jepang, dilanjutkan penandatanganan kontrak kerja.
            </p>
          </div>

          <div class="bg-white rounded p-6 border border-brand-border relative">
            <div class="text-brand-vermilion font-heading font-black text-2xl mb-3">05</div>
            <h4 class="font-heading font-bold text-base text-brand-charcoal">COE & Keberangkatan</h4>
            <p class="text-xs font-body text-brand-slate mt-2 leading-relaxed">
              Pengurusan sertifikat kelayakan (COE), penerbitan visa kerja oleh kedutaan, pembekalan akhir, dan pelepasan terbang ke Jepang.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- SECTION 08: GALLERY PREVIEW (EDITORIAL MASONRY) -->
    <section class="py-20 md:py-28 bg-white border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
          <div class="space-y-3">
            <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
              DOKUMENTASI / 活動記録
            </span>
            <h2 class="text-3xl sm:text-4xl font-heading font-bold text-brand-charcoal">
              Life at Saindo — Suasana Pelatihan Sehari-hari.
            </h2>
          </div>
          <div>
            <a href="/gallery" class="inline-flex items-center text-sm font-heading font-semibold text-brand-charcoal hover:text-brand-vermilion transition-colors">
              Lihat Seluruh Galeri <span class="ml-1.5">→</span>
            </a>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="rounded overflow-hidden border border-brand-border bg-brand-sand aspect-[4/3] group relative">
