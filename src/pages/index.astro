---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustMetrics from '../components/home/TrustMetrics.astro';
import IntroSection from '../components/home/IntroSection.astro';
import ProgramsSection from '../components/home/ProgramsSection.astro';
import WhySaindo from '../components/home/WhySaindo.astro';
import CompanyPartners from '../components/home/CompanyPartners.astro';
import LearningJourney from '../components/home/LearningJourney.astro';
import GalleryPreview from '../components/home/GalleryPreview.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import LatestNews from '../components/home/LatestNews.astro';
import ConsultationCta from '../components/home/ConsultationCta.astro';
---

<MainLayout
  title="LPK Saindo — Lembaga Pelatihan Kerja Resmi Menuju Karier di Jepang"
  description="Lembaga Pelatihan Kerja resmi ke Jepang berizin SO Kemenaker RI. Program Bahasa Jepang intensif, Magang Industri (Ginou Jisshuusei), dan Tenaga Kerja Berketerampilan Spesifik (Tokutei Ginou / SSW)."
  lang="id"
>
  <Navbar currentLang="id" />
  
  <main>
    <!-- 02. Hero Section -->
    <HeroSection currentLang="id" />

    <!-- 03. Trust Indicators & Metrics -->
    <TrustMetrics currentLang="id" />

    <!-- 04. Introduction & Philosophy -->
    <IntroSection currentLang="id" />

    <!-- 05. Programs & Curriculum Tracks -->
    <ProgramsSection currentLang="id" />

    <!-- 06. Why Saindo (Split Editorial) -->
    <WhySaindo currentLang="id" />

    <!-- 06b. Mitra Perusahaan Jepang (Corporate Partners) -->
    <CompanyPartners currentLang="id" />

    <!-- 07. Learning Journey Roadmap -->
    <LearningJourney currentLang="id" />

    <!-- 08. Life at Saindo (Gallery Preview) -->
    <GalleryPreview currentLang="id" />

    <!-- 09. Alumni Stories & Testimonials -->
    <TestimonialsSection currentLang="id" />

    <!-- 10. Latest Articles & News -->
    <LatestNews currentLang="id" />

    <!-- 11. Final Call To Action Banner -->
    <ConsultationCta currentLang="id" />
  </main>

  <!-- 12. Corporate Japanese Footer -->
  <Footer currentLang="id" />
</MainLayout>
