---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<MainLayout
  title="Hubungi Kami & Lokasi — LPK Saindo"
  description="Alamat kantor resmi dan pusat pelatihan LPK Saindo. Hubungi konselor kami melalui WhatsApp, email, atau kunjungi langsung kampus kami."
  lang="id"
>
  <Navbar currentLang="id" />

  <main>
    <!-- Header Banner -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>KONTAK & LOKASI</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">お問い合わせ</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            Konsultasikan Impian Kariermu Bersama Tim LPK Saindo.
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            Kami siap melayani pertanyaan mengenai persyaratan pendaftaran, jadwal tes seleksi, rincian biaya transparan, serta kerja sama kelembagaan.
          </p>
        </div>
      </Container>
    </section>

    <!-- Contact Info & Interactive Form -->
    <section class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <!-- Left Column: Contact Cards -->
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-3">
              <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
                INFORMASI KANTOR PUSAT
              </span>
              <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-charcoal">
                Pusat Pelatihan & Asrama Saindo
              </h2>
            </div>

            <div class="space-y-6 text-sm font-body text-brand-slate">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">Alamat Kampus:</h3>
                  <p class="mt-1 leading-relaxed">
                    Jl. Pendidikan Kejuruan No. 88, Cibinong, Bogor, Jawa Barat 16911, Indonesia
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">WhatsApp & Hotline:</h3>
                  <p class="mt-1 leading-relaxed">
                    <a href="https://wa.me/628123456789" class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      +62 812-3456-7890
                    </a> (Fast Response)
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">Email Resmi:</h3>
                  <p class="mt-1 leading-relaxed">
                    <a href="mailto:info@lpksaindo.com" class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      info@lpksaindo.com
                    </a>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">Jam Operasional:</h3>
                  <p class="mt-1 leading-relaxed">
                    Senin — Sabtu: 08.00 – 17.00 WIB<br />
                    Minggu / Hari Libur Nasional: Tutup
                  </p>
                </div>
              </div>
            </div>

            <!-- Direct WhatsApp Box -->
            <div class="p-6 rounded bg-brand-porcelain border border-brand-border space-y-3">
              <span class="text-xs font-heading font-bold text-brand-charcoal uppercase tracking-wider">
                Respon Cepat via WhatsApp
              </span>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                Ingin konsultasi langsung tanpa mengisi form? Hubungi konselor kami melalui tautan cepat berikut.
              </p>
              <Button
                variant="primary"
                size="md"
                href="https://wa.me/628123456789?text=Halo%20LPK%20Saindo%2C%20saya%20ingin%20konsultasi%20langsung"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full"
              >
                Chat WhatsApp Sekarang
              </Button>
            </div>
          </div>

          <!-- Right Column: Consultation Form -->
          <div class="lg:col-span-7 card-shoji rounded-lg border border-brand-border bg-white p-8 sm:p-10 shadow-sm space-y-6">
            <div class="space-y-2">
              <h3 class="text-2xl font-heading font-bold text-brand-charcoal">
                Kirim Pesan atau Jadwalkan Kunjungan
              </h3>
              <p class="text-sm font-body text-brand-slate">
                Silakan lengkapi formulir di bawah ini. Tim kami akan menghubungi Anda dalam waktu 1x24 jam kerja.
              </p>
            </div>

            <form
              action="https://wa.me/628123456789"
              method="GET"
              target="_blank"
              class="space-y-5"
            >
              <div>
                <label for="name" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                  Nama Lengkap *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Contoh: Budi Santoso"
                  class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                    Nomor WhatsApp Aktif *
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="08123456789"
                    class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                  />
                </div>
                <div>
                  <label for="program" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                    Program Peminatan *
                  </label>
                  <select
                    id="program"
                    name="program"
                    class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                  >
                    <option value="Bahasa Jepang Intensif (N5-N3)">Kursus Bahasa Jepang Intensif</option>
                    <option value="Tokutei Ginou SSW">Specified Skilled Worker (SSW)</option>
                    <option value="Pemagangan Industri (Ginou Jisshuusei)">Pemagangan Industri (Magang)</option>
                    <option value="Belum Tahu / Konsultasi Minat">Belum Tahu (Butuh Konsultasi)</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                  Pesan atau Pertanyaan Anda *
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Tuliskan pertanyaan Anda mengenai biaya, persyaratan, atau jadwal kelas..."
                  class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors resize-none"
                ></textarea>
              </div>

              <Button
                type="submit"
                variant="primary"
                size="lg"
                class="w-full"
              >
                Kirim Formulir Konsultasi
              </Button>
            </form>
          </div>

        </div>
      </Container>
    </section>

    <!-- Embedded Map Section -->
    <section class="py-16 bg-brand-porcelain border-b border-brand-border">
      <Container>
        <div class="space-y-4 mb-6">
          <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            LOKASI KAMPUS
          </span>
          <h2 class="text-2xl font-heading font-bold text-brand-charcoal">
            Petunjuk Arah Menuju Kampus LPK Saindo
          </h2>
        </div>

        <div class="rounded-lg overflow-hidden border border-brand-border bg-brand-sand aspect-[21/9] min-h-[350px] shadow-sm relative">
          <iframe
            title="Peta Lokasi Kampus LPK Saindo"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126844.06348658826!2d106.77253455!3d-6.537234!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69c5e31706b865%3A0x6b8769389e600570!2sBogor%2C%20West%20Java!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full grayscale-[25%] contrast-[1.05]"
          ></iframe>
        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="id" />
</MainLayout>
