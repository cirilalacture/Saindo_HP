---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { getAllSettings } from '../db/queries/settings';

const db = Astro.locals.runtime?.env?.DB;
let settings: Record<string, string> = {};
if (db) {
  try {
    settings = await getAllSettings(db);
  } catch (err) {
    console.error('Failed to load contact settings:', err);
  }
}

const address = settings.address_id || 'Brambang RT 28, Wonokerso, Kedawung, Sragen, Jawa Tengah, Indonesia';
const whatsapp = settings.whatsapp_number || '6282221046007';
const email = settings.contact_email || 'saindopassionglobal@gmail.com';
const emailAlt = 'saindo501@gmail.com';
const workingHours = settings.working_hours_id || 'Senin — Jumat: 08.00 – 17.00 WIB';
const defaultEmbedUrl = 'https://maps.google.com/maps?q=LPK+SAINDO,+Wonokerso,+Kedawung,+Sragen&hl=id&z=16&output=embed';
const mapsUrl = (settings.maps_embed_url && !settings.maps_embed_url.includes('maps.app.goo.gl') && !settings.maps_embed_url.includes('goo.gl'))
  ? settings.maps_embed_url
  : defaultEmbedUrl;
const mapsDirectLink = 'https://maps.app.goo.gl/6x4hLdpSgc6i9X9n9';
---

<MainLayout
  title="Hubungi Kami & Lokasi — LPK Saindo (Saindo Passion Global)"
  description="Alamat resmi kampus LPK Saindo di Sragen, Jawa Tengah. Hubungi kami melalui WhatsApp +62 822 210 460 07 atau kunjungi langsung pusat pelatihan kami."
  lang="id"
>
  <Navbar currentLang="id" />

  <main>
    <!-- Header Banner -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>KONTAK & LOKASI</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">お問い合わせ</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            Konsultasikan Impian Kariermu Bersama Tim LPK Saindo.
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            Kami siap melayani konsultasi pendaftaran 4 jenjang kelas, program Tokutei Ginou (SSW), Engineer / Gijinkoku, serta Matching Job mandiri dengan skema biaya transparan.
          </p>
        </div>
      </Container>
    </section>

    <!-- Contact Info & Interactive Form -->
    <section class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <!-- Left Column: Contact Cards -->
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-3">
              <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
                INFORMASI KANTOR PUSAT
              </span>
              <h2 class="text-2xl sm:text-3xl font-heading font-bold text-brand-charcoal">
                Kampus LPK Saindo di Sragen
              </h2>
            </div>

            <div class="space-y-6 text-sm font-body text-brand-slate">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">Alamat Lengkap:</h3>
                  <p class="mt-1 leading-relaxed">
                    {address}
                  </p>
                  <p class="mt-1">
                    <a href={mapsDirectLink} target="_blank" rel="noopener noreferrer" class="text-xs font-heading font-semibold text-brand-vermilion hover:underline">
                      Buka Google Maps →
                    </a>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">WhatsApp & Telepon:</h3>
                  <p class="mt-1 leading-relaxed">
                    <a href={`https://wa.me/${whatsapp}`} class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      +{whatsapp}
                    </a> (Hotline Resmi)
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">Email Resmi:</h3>
                  <p class="mt-1 leading-relaxed">
                    <a href={`mailto:${email}`} class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      {email}
                    </a>
                  </p>
                  <p class="mt-0.5 leading-relaxed">
                    <a href={`mailto:${emailAlt}`} class="text-brand-charcoal font-semibold hover:text-brand-vermilion">
                      {emailAlt}
                    </a>
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center shrink-0 border border-brand-border">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold text-base text-brand-charcoal">Jam Pelayanan:</h3>
                  <p class="mt-1 leading-relaxed">
                    {workingHours}
                  </p>
                </div>
              </div>
            </div>

            <!-- Direct WhatsApp Box -->
            <div class="p-6 rounded bg-brand-porcelain border border-brand-border space-y-3">
              <span class="text-xs font-heading font-bold text-brand-charcoal uppercase tracking-wider">
                Respon Cepat via WhatsApp
              </span>
              <p class="text-xs font-body text-brand-slate leading-relaxed">
                Ingin konsultasi langsung tanpa mengisi form? Hubungi konselor kami melalui tautan cepat berikut.
              </p>
              <Button
                variant="primary"
                size="md"
                href={`https://wa.me/${whatsapp}?text=Halo%20LPK%20Saindo%2C%20saya%20ingin%20konsultasi%20langsung%20program%20ke%20Jepang`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full"
              >
                Chat WhatsApp Sekarang (+{whatsapp})
              </Button>
            </div>
          </div>

          <!-- Right Column: Consultation Form -->
          <div class="lg:col-span-7 card-shoji rounded-lg border border-brand-border bg-white p-8 sm:p-10 shadow-sm space-y-6">
            <div class="space-y-2">
              <h3 class="text-2xl font-heading font-bold text-brand-charcoal">
                Kirim Pesan atau Jadwalkan Kunjungan
              </h3>
              <p class="text-sm font-body text-brand-slate">
                Silakan lengkapi formulir di bawah ini untuk terhubung langsung dengan tim pendaftaran LPK Saindo di WhatsApp.
              </p>
            </div>

            <form
              id="consultForm"
              action={`https://wa.me/${whatsapp}`}
              method="GET"
              target="_blank"
              class="space-y-5"
            >
              <div>
                <label for="name" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                  Nama Lengkap *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Contoh: Budi Santoso"
                  class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-base sm:text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                    Nomor WhatsApp Aktif *
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="Contoh: 082221046007"
                    class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-base sm:text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                  />
                </div>
                <div>
                  <label for="program" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                    Program Peminatan *
                  </label>
                  <select
                    id="program"
                    name="program"
                    class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-base sm:text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors"
                  >
                    <option value="Tokutei Ginou (SSW)">Program Tokutei Ginou (SSW)</option>
                    <option value="Engineer / Gijinkoku">Program Engineer / Gijinkoku (D3/S1)</option>
                    <option value="Pendidikan 4 Kelas dari Nol (Rp 10 Jt)">Pendidikan dari Nol s/d Matching (Rp 10 Jt)</option>
                    <option value="Masuk Kelas SSW / Matching - Punya JFT (Rp 5 Jt)">Masuk Kelas SSW/Matching (Sudah Ada JFT - Rp 5 Jt)</option>
                    <option value="Matching Job Mandiri (Rp 28 Jt - Include Visa & Tiket)">Matching Job Siswa Mandiri (Rp 28 Jt)</option>
                    <option value="Konsultasi Pemilihan Program">Belum Tahu (Butuh Konsultasi)</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-xs font-heading font-semibold text-brand-charcoal uppercase tracking-wider mb-2">
                  Pesan atau Pertanyaan Anda *
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Tuliskan pertanyaan Anda mengenai jadwal kelas, persyaratan berkas, atau skema pembayaran..."
                  class="w-full px-4 py-3 rounded border border-brand-border bg-brand-porcelain text-base sm:text-sm font-body text-brand-charcoal focus:bg-white focus:outline-none focus:border-brand-charcoal transition-colors resize-none"
                ></textarea>
              </div>

              <Button
                type="submit"
                variant="primary"
                size="lg"
                class="w-full"
              >
                Kirim via WhatsApp (+{whatsapp})
              </Button>
            </form>
          </div>

        </div>
      </Container>
    </section>

    <!-- Embedded Map Section -->
    <section class="py-16 bg-brand-porcelain border-b border-brand-border">
      <Container>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div class="space-y-1">
            <span class="text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
              LOKASI KAMPUS
            </span>
            <h2 class="text-2xl font-heading font-bold text-brand-charcoal">
              Petunjuk Arah Menuju Kampus LPK Saindo di Sragen
            </h2>
            <p class="text-xs text-brand-slate font-body">
              {address}
            </p>
          </div>
          <div>
            <a
              href={mapsDirectLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center px-4 py-2.5 rounded bg-brand-charcoal text-white text-xs font-heading font-semibold hover:bg-brand-vermilion transition-colors"
            >
              Buka di Google Maps App ↗
            </a>
          </div>
        </div>

        <div class="rounded-lg overflow-hidden border border-brand-border bg-brand-sand aspect-[21/9] min-h-[350px] shadow-sm relative">
          <iframe
            title="Peta Lokasi Kampus LPK Saindo Sragen"
            src={mapsUrl}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full"
          ></iframe>
        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="id" />
</MainLayout>
