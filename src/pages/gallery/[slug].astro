---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Lightbox from '../../components/gallery/Lightbox';
import { getAlbumBySlug } from '../../db/queries/gallery';

const { slug } = Astro.params;
const db = Astro.locals.runtime?.env?.DB;

let albumData: any = null;

if (db && slug) {
  try {
    albumData = await getAlbumBySlug(db, slug);
  } catch (err) {
    console.error('Failed to query album from D1:', err);
  }
}

if (!albumData) {
  return Astro.redirect('/gallery');
}

const { album, items } = albumData;
---

<MainLayout
  title={`${album.titleId} — Galeri LPK Saindo`}
  description={album.descriptionId || album.titleId}
  lang="id"
>
  <Navbar currentLang="id" />

  <main>
    <!-- Header Banner -->
    <section class="py-16 md:py-20 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-4xl space-y-4">
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs font-heading font-medium text-brand-stone">
            <a href="/" class="hover:text-brand-charcoal transition-colors">Beranda</a>
            <span>/</span>
            <a href="/gallery" class="hover:text-brand-charcoal transition-colors">Galeri</a>
            <span>/</span>
            <span class="text-brand-charcoal font-semibold truncate">{album.titleId}</span>
          </nav>

          <div class="space-y-2">
            {album.eventDate && (
              <span class="text-xs font-heading font-semibold text-brand-vermilion uppercase tracking-wider">
                Tanggal Kegiatan: {album.eventDate}
              </span>
            )}
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
              {album.titleId}
            </h1>
            {album.descriptionId && (
              <p class="text-base sm:text-lg text-brand-slate font-body leading-relaxed pt-1">
                {album.descriptionId}
              </p>
            )}
          </div>
        </div>
      </Container>
    </section>

    <!-- Photo Lightbox Section -->
    <section class="py-16 md:py-24 bg-white border-b border-brand-border">
      <Container>
        {items && items.length > 0 ? (
          <Lightbox
            client:load
            photos={items}
            currentLang="id"
          />
        ) : (
          <div class="text-center py-16 bg-brand-porcelain rounded border border-brand-border">
            <p class="text-sm text-brand-slate font-heading">Album ini belum memiliki koleksi foto.</p>
          </div>
        )}

        <div class="pt-12 text-center">
          <Button variant="outline" size="md" href="/gallery">
            ← Kembali ke Seluruh Album Galeri
          </Button>
        </div>
      </Container>
    </section>
  </main>

  <Footer currentLang="id" />
</MainLayout>
