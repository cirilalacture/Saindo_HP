---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import { getPublishedAlbums, type AlbumListItem } from '../../db/queries/gallery';

let albums: AlbumListItem[] = [];
const db = Astro.locals.runtime?.env?.DB;

if (db) {
  try {
    albums = await getPublishedAlbums(db);
  } catch (err) {
    console.error('Failed to fetch albums from D1:', err);
  }
}
---

<MainLayout
  title="Galeri Dokumentasi — LPK Saindo (Kegiatan Pelatihan & Pelepasan Siswa)"
  description="Dokumentasi foto kegiatan belajar, latihan kaiwa bahasa Jepang, simulasi kerja Tokutei Ginou, dan pelepasan siswa LPK Saindo ke Jepang."
  lang="id"
>
  <Navbar currentLang="id" />

  <main>
    <!-- Banner Header -->
    <section class="py-16 md:py-24 bg-[#FAFAF8] border-b border-brand-border">
      <Container>
        <div class="max-w-3xl space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
            <span>DOKUMENTASI FOTO</span>
            <span class="text-brand-stone">/</span>
            <span class="font-japanese text-brand-stone">活動ギャラリー</span>
          </div>
          <h1 class="text-4xl sm:text-5xl font-heading font-extrabold text-brand-charcoal tracking-tight leading-tight">
            Rekam Jejak & Kehidupan Siswa di LPK Saindo.
          </h1>
          <p class="text-lg text-brand-slate font-body leading-relaxed">
            Melihat lebih dekat kedisiplinan belajar di kelas, latihan percakapan bersama native speaker, simulasi kejuruan, dan momen bahagia pelepasan siswa terbang ke Jepang.
          </p>
        </div>
      </Container>
    </section>

    <!-- Album Grid -->
    <section class="py-20 md:py-28 bg-white border-b border-brand-border">
      <Container>
        {albums.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {albums.map((album) => (
              <a
                href={`/gallery/${album.slug}`}
                class="card-shoji rounded-lg overflow-hidden group bg-white border border-brand-border p-3 flex flex-col justify-between"
              >
                <div>
                  <div class="aspect-[4/3] rounded bg-brand-sand overflow-hidden relative">
                    <img
                      src={album.coverUrl || 'https://images.unsplash.com/photo-1543269865-cbf427effbad?auto=format&fit=crop&w=800&q=80'}
                      alt={album.titleId}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute bottom-3 right-3 px-3 py-1 rounded-full bg-black/75 text-white text-[11px] font-heading font-semibold flex items-center gap-1.5 shadow-sm">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <span>{album.itemCount} Foto</span>
                    </div>
                  </div>

                  <div class="p-4 space-y-2">
                    {album.eventDate && (
                      <span class="text-xs font-heading font-medium text-brand-stone">
                        {album.eventDate}
                      </span>
                    )}
                    <h2 class="font-heading font-bold text-lg text-brand-charcoal leading-snug group-hover:text-brand-vermilion transition-colors">
                      {album.titleId}
                    </h2>
                    {album.descriptionId && (
                      <p class="text-xs font-body text-brand-slate line-clamp-2 leading-relaxed">
                        {album.descriptionId}
                      </p>
                    )}
                  </div>
                </div>

                <div class="px-4 pb-3 pt-2 border-t border-brand-border/60 text-xs font-heading font-semibold text-brand-charcoal group-hover:text-brand-vermilion inline-flex items-center">
                  Buka Album Foto <span class="ml-1">→</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-brand-porcelain rounded border border-brand-border space-y-3">
            <p class="text-base text-brand-slate font-heading font-medium">Belum ada album dokumentasi yang dipublikasikan.</p>
          </div>
        )}
      </Container>
    </section>
  </main>

  <Footer currentLang="id" />
</MainLayout>
