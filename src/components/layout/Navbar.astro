---
interface Props {
  currentLang?: 'id' | 'ja';
}

const { currentLang = 'id' } = Astro.props;

const navLinks = currentLang === 'ja' ? [
  { href: '/ja', label: 'ホーム' },
  { href: '/ja/about', label: '私たちについて' },
  { href: '/ja/programs', label: '研修プログラム' },
  { href: '/ja/gallery', label: '活動ギャラリー' },
  { href: '/ja/blog', label: 'お知らせ' },
  { href: '/ja/contact', label: 'お問い合わせ' },
] : [
  { href: '/', label: 'Beranda' },
  { href: '/about', label: 'Tentang Kami' },
  { href: '/programs', label: 'Program' },
  { href: '/gallery', label: 'Galeri' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Kontak' },
];

const ctaText = currentLang === 'ja' ? 'お問い合わせ' : 'Daftar Sekarang';
---

<header class="sticky top-0 z-50 w-full bg-[#FAFAF8]/90 backdrop-blur-md border-b border-brand-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={currentLang === 'ja' ? '/ja' : '/'} class="flex items-center gap-3.5 group">
        <div class="w-10 h-10 rounded bg-brand-vermilion flex items-center justify-center text-white font-heading font-extrabold text-xl shadow-sm group-hover:bg-brand-crimson transition-colors">
          S
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-lg tracking-tight text-brand-charcoal leading-none">
            LPK SAINDO
          </span>
          <span class="text-[11px] font-japanese font-medium text-brand-stone tracking-wider mt-1">
            日本語・技能研修機関
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[14px] font-heading font-medium text-brand-slate hover:text-brand-charcoal transition-colors tracking-wide relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-brand-vermilion hover:after:w-full after:transition-all after:duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Controls: Language Switcher & Primary CTA -->
      <div class="hidden sm:flex items-center gap-5">
        <!-- Language Switcher Pill -->
        <div class="flex items-center p-0.5 rounded-full bg-brand-sand border border-brand-border text-[12px] font-heading font-semibold">
          <a
            href="/"
            class={`px-2.5 py-1 rounded-full transition-all ${
              currentLang === 'id'
                ? 'bg-brand-white text-brand-charcoal shadow-sm'
                : 'text-brand-stone hover:text-brand-charcoal'
            }`}
          >
            ID
          </a>
          <a
            href="/ja"
            class={`px-2.5 py-1 rounded-full transition-all ${
              currentLang === 'ja'
                ? 'bg-brand-white text-brand-charcoal shadow-sm'
                : 'text-brand-stone hover:text-brand-charcoal'
            }`}
          >
            日本語
          </a>
        </div>

        <!-- Primary Action Button -->
        <a
          href="https://wa.me/628123456789?text=Halo%20LPK%20Saindo%2C%20saya%20ingin%20konsultasi%20program%20pelatihan%20ke%20Jepang"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded bg-brand-vermilion text-white text-[13px] font-heading font-semibold tracking-wide hover:bg-brand-crimson transition-all shadow-sm active:scale-[0.98]"
        >
          {ctaText}
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex sm:hidden items-center gap-3">
        <a
          href={currentLang === 'ja' ? '/' : '/ja'}
          class="text-xs font-semibold px-2 py-1 rounded bg-brand-sand text-brand-charcoal"
        >
          {currentLang === 'ja' ? 'ID' : '日本語'}
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded text-brand-charcoal hover:bg-brand-sand transition"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-brand-border bg-brand-porcelain px-4 pt-3 pb-6 space-y-3">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-2 text-base font-heading font-medium text-brand-charcoal border-b border-brand-border/50"
      >
        {link.label}
      </a>
    ))}
    <div class="pt-3">
      <a
        href="https://wa.me/628123456789"
        class="block w-full text-center py-3 rounded bg-brand-vermilion text-white font-heading font-semibold text-sm"
      >
        {ctaText}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
