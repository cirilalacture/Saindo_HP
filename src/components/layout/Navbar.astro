---
import MobileMenu from './MobileMenu';
import Button from '../ui/Button.astro';

interface Props {
  currentLang?: 'id' | 'ja';
}

const { currentLang = 'id' } = Astro.props;

const navLinks = currentLang === 'ja' ? [
  { href: '/ja', label: 'ホーム' },
  { href: '/ja/about', label: '私たちについて' },
  { href: '/ja/programs', label: '研修プログラム' },
  { href: '/ja/gallery', label: '活動ギャラリー' },
  { href: '/ja/blog', label: 'お知らせ' },
  { href: '/ja/contact', label: 'お問い合わせ' },
] : [
  { href: '/', label: 'Beranda' },
  { href: '/about', label: 'Tentang Kami' },
  { href: '/programs', label: 'Program' },
  { href: '/gallery', label: 'Galeri' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Kontak' },
];

const ctaText = currentLang === 'ja' ? 'お問い合わせ' : 'Daftar Sekarang';
---

<header class="sticky top-0 z-50 w-full bg-[#FAFAF8]/95 backdrop-blur-md border-b border-brand-border transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={currentLang === 'ja' ? '/ja' : '/'} class="flex items-center gap-3.5 group">
        <img
          src="/assets/logo/logo.png"
          alt="LPK Saindo"
          class="w-10 h-10 object-contain group-hover:scale-105 transition-transform"
        />
        <div class="flex flex-col">
          <span class="font-heading font-extrabold text-lg tracking-tight text-brand-charcoal leading-none">
            LPK SAINDO
          </span>
          <span class="text-[11px] font-japanese font-medium text-brand-stone tracking-wider mt-1">
            日本語・技能研修機関
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[14px] font-heading font-medium text-brand-slate hover:text-brand-charcoal transition-colors tracking-wide relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-brand-vermilion hover:after:w-full after:transition-all after:duration-200"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Controls: Font Size Resizer, Language Switcher & Primary CTA -->
      <div class="hidden md:flex items-center gap-4">
        <!-- Font Size Resizer Pill (A- / A / A+) -->
        <div
          class="flex items-center p-0.5 rounded-full bg-brand-sand border border-brand-border text-[11px] font-heading font-bold"
          role="group"
          aria-label={currentLang === 'ja' ? '文字サイズ変更' : 'Ubah Ukuran Huruf'}
        >
          <button
            type="button"
            data-font-btn="sm"
            class="px-2.5 py-1 rounded-full text-brand-stone hover:text-brand-charcoal transition-all text-xs"
            title={currentLang === 'ja' ? '文字サイズ（小）' : 'Ukuran Huruf Kecil'}
            aria-label="Font kecil"
          >
            A-
          </button>
          <button
            type="button"
            data-font-btn="base"
            class="px-2.5 py-1 rounded-full bg-brand-white text-brand-charcoal shadow-sm transition-all text-xs font-extrabold"
            title={currentLang === 'ja' ? '文字サイズ（標準）' : 'Ukuran Huruf Normal'}
            aria-label="Font normal"
          >
            A
          </button>
          <button
            type="button"
            data-font-btn="lg"
            class="px-2.5 py-1 rounded-full text-brand-stone hover:text-brand-charcoal transition-all text-xs"
            title={currentLang === 'ja' ? '文字サイズ（大）' : 'Ukuran Huruf Besar'}
            aria-label="Font besar"
          >
            A+
          </button>
        </div>

        <!-- Language Switcher Pill -->
        <div class="flex items-center p-0.5 rounded-full bg-brand-sand border border-brand-border text-[12px] font-heading font-semibold">
          <a
            href="/"
            class={`px-2.5 py-1 rounded-full transition-all ${
              currentLang === 'id'
                ? 'bg-brand-white text-brand-charcoal shadow-sm'
                : 'text-brand-stone hover:text-brand-charcoal'
            }`}
          >
            ID
          </a>
          <a
            href="/ja"
            class={`px-2.5 py-1 rounded-full transition-all ${
              currentLang === 'ja'
                ? 'bg-brand-white text-brand-charcoal shadow-sm'
                : 'text-brand-stone hover:text-brand-charcoal'
            }`}
          >
            日本語
          </a>
        </div>

        <!-- Primary Action Button -->
        <Button
          variant="primary"
          size="md"
          href="https://wa.me/6282221046007?text=Halo%20LPK%20Saindo%2C%20saya%20ingin%20konsultasi%20program%20pelatihan%20ke%20Jepang"
          target="_blank"
          rel="noopener noreferrer"
        >
          {ctaText}
        </Button>
      </div>

      <!-- Mobile Menu Component (React Island) -->
      <MobileMenu
        client:load
        navLinks={navLinks}
        currentLang={currentLang}
        ctaText={ctaText}
      />

    </div>
  </div>
</header>

<script is:inline>
  (function() {
    const scaleMap = { sm: '90%', base: '100%', lg: '115%' };

    function updateButtons(size) {
      document.querySelectorAll('[data-font-btn]').forEach(function(btn) {
        const btnSize = btn.getAttribute('data-font-btn');
        const isActive = btnSize === size;
        btn.classList.toggle('bg-brand-white', isActive);
        btn.classList.toggle('text-brand-charcoal', isActive);
        btn.classList.toggle('shadow-sm', isActive);
        btn.classList.toggle('font-extrabold', isActive);
        btn.classList.toggle('text-brand-stone', !isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    function setFontSize(size) {
      if (!scaleMap[size]) return;
      document.documentElement.style.fontSize = scaleMap[size];
      try {
        localStorage.setItem('saindo_font_size', size);
      } catch (e) {}
      updateButtons(size);
      window.dispatchEvent(new CustomEvent('saindo_font_size_change', { detail: { size: size } }));
    }

    function init() {
      let current = 'base';
      try {
        const saved = localStorage.getItem('saindo_font_size');
        if (saved && scaleMap[saved]) current = saved;
      } catch (e) {}
      updateButtons(current);

      document.querySelectorAll('[data-font-btn]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          const size = btn.getAttribute('data-font-btn');
          if (size) setFontSize(size);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    window.addEventListener('saindo_font_size_change', function(e) {
      if (e.detail && e.detail.size) {
        updateButtons(e.detail.size);
      }
    });
  })();
</script>
