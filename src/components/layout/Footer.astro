---
import { getAllSettings } from '../../db/queries/settings';

interface Props {
  currentLang?: 'id' | 'ja';
}

const { currentLang = 'id' } = Astro.props;
const db = Astro.locals.runtime?.env?.DB;

let settings: Record<string, string> = {};
if (db) {
  try {
    settings = await getAllSettings(db);
  } catch (err) {
    console.error('Failed to load settings in footer:', err);
  }
}

const soLicense = settings.so_license_number || 'KEMNAKER RI No. 2/XXX/HK.01/2022';
const vinNumber = settings.vin_number || '2209320401';
const whatsapp = settings.whatsapp_number || '628123456789';
const email = settings.contact_email || 'info@lpksaindo.com';
const address = currentLang === 'ja'
  ? (settings.address_ja || settings.address_id || 'インドネシア西ジャワ州 職業訓練教育通り88号')
  : (settings.address_id || 'Jl. Pendidikan Kejuruan No. 88, Jawa Barat, Indonesia');
const workingHours = currentLang === 'ja'
  ? (settings.working_hours_ja || '月曜日〜金曜日: 08:00〜17:00 (WIB)')
  : (settings.working_hours_id || 'Senin – Sabtu: 08:00 – 17:00 WIB');
---

<footer class="bg-brand-charcoal text-white pt-16 pb-12 border-t border-brand-charcoal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-5 space-y-5">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded bg-brand-vermilion flex items-center justify-center text-white font-heading font-extrabold text-lg">
            S
          </div>
          <span class="font-heading font-extrabold text-xl tracking-tight text-white">
            {settings.site_name || 'LPK SAINDO'}
          </span>
        </div>
        <p class="text-sm font-body text-gray-400 leading-relaxed max-w-sm">
          {currentLang === 'ja'
            ? (settings.tagline_ja || 'LPK Saindoは、インドネシアの有望な若者を育成し、日本の優良企業および監理団体へ送り出す認定教育機関です。')
            : (settings.tagline_id || 'Lembaga Pelatihan Kerja resmi ke Jepang berizin SO & Kemnaker. Membina generasi muda berkarakter, mahir berbahasa Jepang, dan memiliki keahlian vokasi terstandar industri.')}
        </p>
        <div class="pt-2 text-xs text-gray-400 space-y-1">
          <p><span class="text-gray-300 font-semibold">Izin Resmi SO:</span> {soLicense}</p>
          <p><span class="text-gray-300 font-semibold">VIN Lembaga:</span> {vinNumber}</p>
        </div>
      </div>

      <!-- Quick Navigation -->
      <div class="md:col-span-3 space-y-4">
        <h4 class="font-heading font-semibold text-xs uppercase tracking-widest text-brand-sand">
          {currentLang === 'ja' ? 'ナビゲーション' : 'Menu Navigasi'}
        </h4>
        <ul class="space-y-2.5 text-sm font-body text-gray-400">
          <li><a href={currentLang === 'ja' ? '/ja' : '/'} class="hover:text-white transition-colors">{currentLang === 'ja' ? 'ホーム' : 'Beranda'}</a></li>
          <li><a href={currentLang === 'ja' ? '/ja/about' : '/about'} class="hover:text-white transition-colors">{currentLang === 'ja' ? '私たちについて' : 'Tentang Kami'}</a></li>
          <li><a href={currentLang === 'ja' ? '/ja/programs' : '/programs'} class="hover:text-white transition-colors">{currentLang === 'ja' ? '研修プログラム' : 'Program Pelatihan'}</a></li>
          <li><a href={currentLang === 'ja' ? '/ja/gallery' : '/gallery'} class="hover:text-white transition-colors">{currentLang === 'ja' ? '活動ギャラリー' : 'Galeri Dokumentasi'}</a></li>
          <li><a href={currentLang === 'ja' ? '/ja/blog' : '/blog'} class="hover:text-white transition-colors">{currentLang === 'ja' ? 'お知らせ' : 'Warta & Artikel'}</a></li>
          <li><a href={currentLang === 'ja' ? '/ja/contact' : '/contact'} class="hover:text-white transition-colors">{currentLang === 'ja' ? 'お問い合わせ' : 'Kontak & Lokasi'}</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div class="md:col-span-4 space-y-4">
        <h4 class="font-heading font-semibold text-xs uppercase tracking-widest text-brand-sand">
          {currentLang === 'ja' ? '連絡先' : 'Kantor & Pusat Pelatihan'}
        </h4>
        <p class="text-sm font-body text-gray-400 leading-relaxed">
          {address}
        </p>
        <div class="space-y-2 text-sm text-gray-400 font-body">
          <p class="flex items-center gap-2">
            <span class="text-brand-vermilion">WA:</span>
            <a href={`https://wa.me/${whatsapp}`} class="hover:text-white transition-colors">+{whatsapp}</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-brand-vermilion">Email:</span>
            <a href={`mailto:${email}`} class="hover:text-white transition-colors">{email}</a>
          </p>
          <p class="flex items-center gap-2">
            <span class="text-brand-vermilion">Jam:</span>
            <span>{workingHours}</span>
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-4">
      <p>© {new Date().getFullYear()} {settings.site_name || 'LPK Saindo'}. All Rights Reserved. Japanese Corporate Minimalist Architecture.</p>
      <div class="flex items-center gap-6">
        <a href="/admin/dashboard" class="hover:text-gray-300 transition-colors">Portal Admin</a>
        <a href="#" class="hover:text-gray-300 transition-colors">Kebijakan Privasi</a>
        <a href="#" class="hover:text-gray-300 transition-colors">Syarat & Ketentuan</a>
      </div>
    </div>
  </div>
</footer>
