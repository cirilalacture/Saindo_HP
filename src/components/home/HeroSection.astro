---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import HeroCarousel from './HeroCarousel';

interface Props {
  currentLang?: 'id' | 'ja';
}

const { currentLang = 'id' } = Astro.props;

const isJa = currentLang === 'ja';
---

<section class="relative overflow-hidden pt-12 pb-20 md:py-28 bg-[#FAFAF8] border-b border-brand-border">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Left Editorial Column -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Rubric pill -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-brand-sand border border-brand-border text-[11px] font-heading font-semibold tracking-wider text-brand-charcoal uppercase">
          <span class="w-2 h-2 rounded-full bg-brand-vermilion"></span>
          {isJa ? 'インドネシア・スラゲン発 日本就労支援機関' : 'LPK Sukses Abadi Indonesia • Sragen, Jawa Tengah'}
        </div>

        <!-- Master Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-heading font-extrabold text-brand-charcoal leading-[1.12] tracking-tight">
          {isJa ? (
            <>
              あなたの未来はここから始まる。<br />
              <span class="text-brand-vermilion">Saindoと共に</span> 日本へ。
            </>
          ) : (
            <>
              Masa Depanmu Dimulai dari Sini. <span class="text-brand-vermilion">Melangkah Bersama Saindo</span> Menuju Jepang.
            </>
          )}
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-brand-slate font-body leading-relaxed max-w-2xl">
          {isJa
            ? 'LPK Saindo (Saindo Passion Global) は、スラゲンを拠点に特定技能（SSW）および技術・人文知識・国際業務（技人国/エンジニア）の専門教育と企業マッチングを提供する正規機関です。'
            : 'Pusat pelatihan kerja resmi ke Jepang spesialis Tokutei Ginou (SSW) dan Engineer / Gijinkoku di Sragen. Bimbingan intensif dari nol bersama Sensei profesional dan Native Speaker asli Jepang hingga sukses matching kerja.'}
        </p>

        <!-- Dual CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
          <Button
            variant="primary"
            size="lg"
            href="https://wa.me/6282221046007?text=Halo%20LPK%20Saindo%2C%20saya%20tertarik%20mendaftar%20pelatihan%20ke%20Jepang"
            target="_blank"
            rel="noopener noreferrer"
          >
            {isJa ? '受入相談・お問い合わせ' : 'Daftar Sekarang'}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </Button>

          <Button
            variant="outline"
            size="lg"
            href="#programs"
          >
            {isJa ? 'プログラム一覧' : 'Pelajari Program'}
          </Button>
        </div>

        <!-- Institutional Key Highlights -->
        <div class="pt-6 border-t border-brand-border/80 flex flex-wrap items-center gap-6 text-xs text-brand-slate font-heading">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Tokutei Ginou & Engineer/Gijinkoku</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Pengajar Native Speaker Asli Jepang</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            <span>Matching Job & Biaya Transparan</span>
          </div>
        </div>

      </div>

      <!-- Right Visual Card with Auto-sliding Carousel (5 seconds) -->
      <div class="lg:col-span-5 relative">
        <HeroCarousel client:load currentLang={currentLang} />
      </div>

    </div>
  </Container>
</section>
