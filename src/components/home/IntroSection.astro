---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

interface Props {
  currentLang?: 'id' | 'ja';
}

const { currentLang = 'id' } = Astro.props;
const isJa = currentLang === 'ja';
---

<section class="py-16 md:py-24 bg-brand-porcelain border-b border-brand-border">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Title & Mission -->
      <div class="lg:col-span-5 space-y-5">
        <div class="inline-flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-widest text-brand-vermilion">
          <span>{isJa ? '私たちについて' : 'TENTANG LEMBAGA'}</span>
          <span class="text-brand-stone">/</span>
          <span class="font-japanese text-brand-stone">{isJa ? 'LPK SAINDO' : '私たちについて'}</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-brand-charcoal leading-tight tracking-tight">
          {isJa
            ? '信頼と高品質な教育で、世界に挑む若者を日本へ。'
            : 'Lembaga Pendidikan & Pelatihan Kerja Berkualitas, Bertanggung Jawab dan Terpercaya.'}
        </h2>

        <p class="text-sm font-heading font-semibold text-brand-stone uppercase tracking-wider">
          {isJa ? 'スラゲン拠点 • 2024年設立 • 特定技能・技人国' : 'LPK Sukses Abadi Indonesia • Berdiri Sejak 2024 di Sragen'}
        </p>
      </div>

      <!-- Right Column: Narrative & Values -->
      <div class="lg:col-span-7 space-y-6 text-brand-slate font-body text-base leading-relaxed">
        <p>
          {isJa
            ? 'LPK Saindo（Saindo Passion Global / LPK Sukses Abadi Indonesia）は、2024年に中部ジャワ州スラゲンにて設立された日本就労特化型の教育研修機関です。特定技能（SSW）および技術・人文知識・国際業務（エンジニア・総合職）プログラムに特化し、確かな語学力と現場適応力を育成しています。'
            : 'LPK Sukses Abadi Indonesia (Saindo Passion Global) adalah lembaga pendidikan dan pelatihan kerja resmi ke Jepang yang berlokasi di Sragen, Jawa Tengah. Berdiri sejak tahun 2024, Saindo berfokus pada program keahlian Tokutei Ginou (SSW) dan Engineer / Gijinkoku.'}
        </p>

        <p>
          {isJa
            ? '初心者から学べる4段階クラス（入門、JFT対策、特定技能、マッチング・会話準備）を体系化し、日本人ネイティブ教員による直接指導と受入企業との直接マッチングを実施。渡航ビザや航空券の手配まで一貫した透明なサポートを提供しています。'
            : 'Kami membuka 4 jenjang kelas terarah: Kelas Pemula (dari 0), Kelas JFT, Kelas SSW, dan Kelas Persiapan Matching / Percakapan (Kaiwa). Didukung pengajar profesional serta Native Speaker asli Jepang, kami juga memfasilitasi program Matching Job transparan baik untuk siswa internal maupun siswa mandiri.'}
        </p>

        <div class="pt-2">
          <Button variant="ghost" size="md" href={isJa ? '/ja/about' : '/about'}>
            {isJa ? '組織概要・許認可を見る' : 'Baca Profil Lengkap & Legalitas Lembaga'}
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </Button>
        </div>
      </div>

    </div>
  </Container>
</section>
