---
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  currentLang?: 'id' | 'ja';
}

const { currentLang = 'id' } = Astro.props;
const isJa = currentLang === 'ja';

const advantages = isJa ? [
  {
    num: '01',
    title: '専門的で経験豊富な講師陣',
    desc: '日本での就労実績や指導経験を持つ有資格講師が、基礎文法から現場実務までわかりやすく丁寧に指導します。',
  },
  {
    num: '02',
    title: '日本人ネイティブ講師による直接指導',
    desc: '日本人の生きた発音、イントネーション、職場で本当に使われる自然な会話（Kaiwa）を毎日直接トレーニング。',
  },
  {
    num: '03',
    title: '確かな就労マッチング支援（Matching Job）',
    desc: '日本全国の優良企業と直接提携。在校生だけでなく外部有資格者（JFT・SSW保持者）への求人紹介も強力に推進。',
  },
  {
    num: '04',
    title: '渡航前・就労中・帰国後の一貫サポート',
    desc: '査証（ビザ）や航空券の手配から、日本入国後の生活相談、就労期間中の定期フォローまで責任を持って伴走。',
  },
  {
    num: '05',
    title: '合格直結の特化型カリキュラム',
    desc: 'JFT-Basic A2、特定技能測定試験、企業面接に特化した無駄のない4段階ステップで最短ルートの合格へ導きます。',
  },
] : [
  {
    num: '01',
    title: 'Pengajar Profesional & Berpengalaman di Bidangnya',
    desc: 'Instruktur bersertifikasi dengan latar belakang pendidikan bahasa Jepang dan pengalaman kerja nyata di industri Jepang.',
  },
  {
    num: '02',
    title: 'Ada Pengajar Native Speaker (Orang Jepang Asli)',
    desc: 'Latihan percakapan intensif (Kaiwa) langsung dibimbing penutur asli Jepang untuk melatih pelafalan alami dan mental wawancara.',
  },
  {
    num: '03',
    title: 'Dukungan Penyaluran Kerja (Matching Job)',
    desc: 'Fasilitas wawancara langsung dengan user perusahaan Jepang. Terbuka bagi siswa Saindo maupun siswa mandiri yang telah memiliki sertifikat JFT & SSW.',
  },
  {
    num: '04',
    title: 'Dukungan Berkelanjutan (Pre, During, Post-Placement)',
    desc: 'Pendampingan terpadu mulai dari pemberkasan COE, pengurusan Visa, tiket pesawat, pendampingan selama bekerja, hingga kepulangan ke tanah air.',
  },
  {
    num: '05',
    title: 'Kurikulum Khusus Berorientasi Kelulusan',
    desc: 'Modul pembelajaran terstruktur 4 kelas (Pemula, JFT, SSW, Persiapan Matching) yang terfokus pada kelulusan ujian resmi dan seleksi user.',
  },
];
---

<section class="py-20 md:py-28 bg-brand-porcelain border-b border-brand-border">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Visual Card: Facility Photo Mosaic (4 Photos: Fasilitas 1, 2, 3 & Buku) -->
      <div class="lg:col-span-6 relative">
        <div class="space-y-3 sm:space-y-4">
          <!-- 2x2 Photo Mosaic Grid -->
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            
            <!-- Photo 1: Fasilitas 1 (Ruang Kelas Utama) -->
            <div class="group relative rounded-lg overflow-hidden border border-brand-border bg-white p-2 shadow-sm hover:shadow-md transition-shadow">
              <div class="aspect-[4/3] rounded overflow-hidden bg-brand-sand relative">
                <img
                  src="/assets/facilities/fasilitas1.jpg"
                  alt="Ruang kelas teori dan pelatihan bahasa Jepang LPK Saindo ber-AC dan nyaman"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex items-end p-2.5 sm:p-3">
                  <span class="text-[11px] sm:text-xs font-heading font-semibold text-white tracking-wide leading-tight drop-shadow-sm">
                    {isJa ? '座学・日本語講義室' : 'Ruang Kelas Teori Ber-AC'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Photo 2: Buku / Modul (buku.jpg) -->
            <div class="group relative rounded-lg overflow-hidden border border-brand-border bg-white p-2 shadow-sm hover:shadow-md transition-shadow">
              <div class="aspect-[4/3] rounded overflow-hidden bg-brand-sand relative">
                <img
                  src="/assets/facilities/buku.jpg"
                  alt="Koleksi buku panduan resmi Minna no Nihongo dan modul materi kurikulum LPK Saindo"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex items-end p-2.5 sm:p-3">
                  <span class="text-[11px] sm:text-xs font-heading font-semibold text-white tracking-wide leading-tight drop-shadow-sm">
                    {isJa ? '公式教材・文法テキスト' : 'Modul Kurikulum Resmi'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Photo 3: Fasilitas 2 -->
            <div class="group relative rounded-lg overflow-hidden border border-brand-border bg-white p-2 shadow-sm hover:shadow-md transition-shadow">
              <div class="aspect-[4/3] rounded overflow-hidden bg-brand-sand relative">
                <img
                  src="/assets/facilities/fasilitas2.jpg"
                  alt="Sarana pelatihan mandiri dan ruang bimbingan simulasi wawancara LPK Saindo"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex items-end p-2.5 sm:p-3">
                  <span class="text-[11px] sm:text-xs font-heading font-semibold text-white tracking-wide leading-tight drop-shadow-sm">
                    {isJa ? '自習・模擬面接スペース' : 'Sarana Belajar & Diskusi'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Photo 4: Fasilitas 3 -->
            <div class="group relative rounded-lg overflow-hidden border border-brand-border bg-white p-2 shadow-sm hover:shadow-md transition-shadow">
              <div class="aspect-[4/3] rounded overflow-hidden bg-brand-sand relative">
                <img
                  src="/assets/facilities/fasilitas3.jpg"
                  alt="Fasilitas kampus dan lingkungan belajar asrama LPK Saindo di Kedawung Sragen"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex items-end p-2.5 sm:p-3">
                  <span class="text-[11px] sm:text-xs font-heading font-semibold text-white tracking-wide leading-tight drop-shadow-sm">
                    {isJa ? '校舎・宿舎付帯施設' : 'Kampus & Asrama Sragen'}
                  </span>
                </div>
              </div>
            </div>

          </div>

          <!-- Bottom Summary Badge -->
          <div class="p-3.5 sm:p-4 rounded-lg bg-white border border-brand-border shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
              <span class="text-xs font-heading font-bold text-brand-charcoal">
                {isJa ? '自社所有の教育施設・充実したオリジナル教材完備' : 'Fasilitas Kampus & Modul Resmi Berstandar Jepang di Sragen'}
              </span>
            </div>
            <a
              href={isJa ? '/ja/about#facilities' : '/about#facilities'}
              class="text-xs font-heading font-semibold text-brand-vermilion hover:underline inline-flex items-center gap-1 shrink-0"
            >
              <span>{isJa ? '施設案内を見る' : 'Lihat Fasilitas Lengkap'}</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Editorial List -->
      <div class="lg:col-span-6 space-y-8">
        <SectionHeader
          tagline={isJa ? '私たちの強み' : 'KEUNGGULAN LEMBAGA'}
          taglineJa={isJa ? 'WHY SAINDO' : '選ばれる理由'}
          title={isJa ? 'なぜ多くの受入機関から信頼されるのか？' : 'Mengapa Memilih LPK Saindo Sebagai Mitra Menuju Jepang?'}
        />

        <div class="space-y-6 pt-2">
          {advantages.map((item) => (
            <div class="flex items-start gap-4 sm:gap-5">
              <div class="w-9 h-9 rounded bg-brand-sand text-brand-vermilion flex items-center justify-center font-heading font-extrabold text-sm shrink-0 border border-brand-border mt-0.5">
                {item.num}
              </div>
              <div class="space-y-1">
                <h4 class="font-heading font-bold text-base sm:text-lg text-brand-charcoal">
                  {item.title}
                </h4>
                <p class="text-sm font-body text-brand-slate leading-relaxed">
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </Container>
</section>
