---
interface Props {
  title: string;
  activeNav?: 'dashboard' | 'posts' | 'gallery' | 'media' | 'settings';
}

const { title, activeNav = 'dashboard' } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — CMS LPK Saindo</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#FAFAF8] text-brand-charcoal font-sans antialiased flex flex-col md:flex-row selection:bg-brand-vermilion selection:text-white">
    
    <!-- Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-white border-r border-brand-border flex flex-col shrink-0">
      
      <!-- Logo Brand Box -->
      <div class="p-6 border-b border-brand-border flex items-center justify-between">
        <a href="/admin/dashboard" class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-brand-vermilion text-white flex items-center justify-center font-heading font-black text-base shadow-sm">
            S
          </div>
          <div class="flex flex-col">
            <span class="font-heading font-bold text-sm tracking-tight text-brand-charcoal leading-none">
              CMS SAINDO
            </span>
            <span class="font-japanese text-[10px] text-brand-stone font-medium tracking-wider mt-0.5">
              管理システム
            </span>
          </div>
        </a>

        <!-- Live Web Link -->
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          title="Buka Website Publik"
          class="p-1.5 rounded text-brand-stone hover:text-brand-charcoal hover:bg-brand-sand transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>

      <!-- Navigation Menu Items -->
      <nav class="flex-1 p-4 space-y-1.5">
        <a
          href="/admin/dashboard"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-heading font-semibold transition-colors ${
            activeNav === 'dashboard'
              ? 'bg-brand-charcoal text-white shadow-sm'
              : 'text-brand-slate hover:bg-brand-sand hover:text-brand-charcoal'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
          <span>Dashboard Overview</span>
        </a>

        <a
          href="/admin/posts"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-heading font-semibold transition-colors ${
            activeNav === 'posts'
              ? 'bg-brand-charcoal text-white shadow-sm'
              : 'text-brand-slate hover:bg-brand-sand hover:text-brand-charcoal'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
          </svg>
          <span>Warta & Blog</span>
        </a>

        <a
          href="/admin/gallery"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-heading font-semibold transition-colors ${
            activeNav === 'gallery'
              ? 'bg-brand-charcoal text-white shadow-sm'
              : 'text-brand-slate hover:bg-brand-sand hover:text-brand-charcoal'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span>Galeri Foto</span>
        </a>

        <a
          href="/admin/media"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-heading font-semibold transition-colors ${
            activeNav === 'media'
              ? 'bg-brand-charcoal text-white shadow-sm'
              : 'text-brand-slate hover:bg-brand-sand hover:text-brand-charcoal'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
          </svg>
          <span>Media Library</span>
        </a>

        <a
          href="/admin/settings"
          class={`flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-xs font-heading font-semibold transition-colors ${
            activeNav === 'settings'
              ? 'bg-brand-charcoal text-white shadow-sm'
              : 'text-brand-slate hover:bg-brand-sand hover:text-brand-charcoal'
          }`}
        >
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Pengaturan Situs</span>
        </a>
      </nav>

      <!-- Bottom User Profile & Logout -->
      <div class="p-4 border-t border-brand-border bg-[#FAFAF8]/60 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-brand-charcoal text-white flex items-center justify-center font-heading font-bold text-xs uppercase shrink-0">
            {user?.name ? user.name.charAt(0) : 'A'}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-heading font-bold text-brand-charcoal truncate">
              {user?.name || 'Administrator'}
            </p>
            <p class="text-[11px] text-brand-stone font-mono truncate">
              {user?.email || 'admin@lpksaindo.com'}
            </p>
          </div>
        </div>

        <a
          href="/admin/logout"
          class="w-full py-2 px-3 rounded border border-brand-border hover:border-red-300 hover:bg-red-50 hover:text-red-700 text-xs font-heading font-semibold text-brand-slate transition-colors flex items-center justify-center gap-2"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
          <span>Keluar (Logout)</span>
        </a>
      </div>

    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      
      <!-- Top Bar -->
      <header class="h-16 border-b border-brand-border bg-white px-6 sm:px-10 flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
          <span class="text-xs font-heading font-bold text-brand-vermilion uppercase tracking-widest">
            CMS ADMIN
          </span>
          <span class="text-brand-border">/</span>
          <h1 class="text-sm font-heading font-bold text-brand-charcoal">
            {title}
          </h1>
        </div>

        <div class="flex items-center gap-4 text-xs font-heading">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-green-50 border border-green-200 text-green-700 font-medium">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span>D1 Active</span>
          </div>

          <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1 text-brand-slate hover:text-brand-charcoal font-semibold transition-colors"
          >
            Lihat Web Publik ↗
          </a>
        </div>
      </header>

      <!-- Page Content Slot -->
      <main class="flex-1 p-6 sm:p-10 max-w-7xl w-full mx-auto">
        <slot />
      </main>

    </div>

  </body>
</html>
