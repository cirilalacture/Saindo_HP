---
import '../styles/global.css';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'id' | 'ja';
}

const {
  title = 'LPK Saindo — Pelatihan Bahasa & Penempatan Kerja ke Jepang',
  description = 'Lembaga Pelatihan Kerja resmi ke Jepang. Program Pemagangan (Ginou Jisshuusei) dan Tenaga Kerja Berketerampilan Spesifik (Tokutei Ginou / SSW).',
  lang = 'id',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://lpksaindo.com/assets/logo/logo.png" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'id_ID'} />
    <link rel="alternate" hreflang="id" href="https://lpksaindo.com/" />
    <link rel="alternate" hreflang="ja" href="https://lpksaindo.com/ja/" />

    <!-- JSON-LD Structured Data for EducationalOrganization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'EducationalOrganization',
      name: 'LPK Sukses Abadi Indonesia (Saindo Passion Global)',
      alternateName: 'LPK Saindo',
      url: 'https://lpksaindo.com',
      logo: 'https://lpksaindo.com/assets/logo/logo.png',
      description: description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Brambang RT 28, Wonokerso, Kedawung',
        addressLocality: 'Sragen',
        addressRegion: 'Jawa Tengah',
        postalCode: '57292',
        addressCountry: 'ID',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+62-822-210-460-07',
        contactType: 'customer service',
        availableLanguage: ['Indonesian', 'Japanese'],
      },
      sameAs: [
        'https://instagram.com/lpksaindo',
        'https://facebook.com/lpksaindo',
      ],
    })} />
    <!-- Font Size Controller Script (Zero FOUC) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('saindo_font_size');
          var scaleMap = { sm: '90%', base: '100%', lg: '115%' };
          if (saved && scaleMap[saved]) {
            document.documentElement.style.fontSize = scaleMap[saved];
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-brand-porcelain text-brand-charcoal antialiased selection:bg-brand-vermilion selection:text-white">
    <slot />
    <FloatingWhatsApp lang={lang} />
  </body>
</html>
