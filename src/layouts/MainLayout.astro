---
import '../styles/global.css';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'id' | 'ja';
  canonical?: string;
  image?: string;
  ogType?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = 'LPK Saindo — Pelatihan Bahasa & Penempatan Kerja ke Jepang',
  description = 'Lembaga Pelatihan Kerja resmi ke Jepang. Program Pemagangan (Ginou Jisshuusei) dan Tenaga Kerja Berketerampilan Spesifik (Tokutei Ginou / SSW).',
  lang = 'id',
  canonical,
  image = '/assets/logo/og-image.png',
  ogType = 'website',
  structuredData,
} = Astro.props;

const site = 'https://saindopassion.com';
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ? site + canonical : site + currentPath;
const ogImageUrl = image.startsWith('http') ? image : site + image;
const ogLocale = lang === 'ja' ? 'ja_JP' : 'id_ID';
const isJaPage = currentPath === '/ja' || currentPath.startsWith('/ja/');
const jaPath = isJaPage ? currentPath : currentPath === '/' ? '/ja' : '/ja' + currentPath;
const idPath = isJaPage ? currentPath.replace(/^\/ja(?=\/|$)/, '') || '/' : currentPath;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="id" href={site + idPath} />
    <link rel="alternate" hreflang="ja" href={site + jaPath} />
    <link rel="alternate" hreflang="x-default" href={site + idPath} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data for EducationalOrganization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'EducationalOrganization',
      name: 'LPK Sukses Abadi Indonesia (Saindo Passion Global)',
      alternateName: 'LPK Saindo',
      url: 'https://saindopassion.com',
      logo: 'https://saindopassion.com/assets/logo/logo.png',
      description: description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Brambang RT 28, Wonokerso, Kedawung',
        addressLocality: 'Sragen',
        addressRegion: 'Jawa Tengah',
        postalCode: '57292',
        addressCountry: 'ID',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+62-822-210-460-07',
        contactType: 'customer service',
        availableLanguage: ['Indonesian', 'Japanese'],
      },
      sameAs: [
        'https://instagram.com/lpksaindo',
        'https://facebook.com/lpksaindo',
      ],
    })} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <!-- Font Size Controller Script (Zero FOUC) -->
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('saindo_font_size');
          var scaleMap = { sm: '90%', base: '100%', lg: '115%' };
          if (saved && scaleMap[saved]) {
            document.documentElement.style.fontSize = scaleMap[saved];
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-brand-porcelain text-brand-charcoal antialiased selection:bg-brand-vermilion selection:text-white">
    <slot />
    <FloatingWhatsApp lang={lang} />
  </body>
</html>
