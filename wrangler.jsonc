{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saindohp",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lpksaindo_db",
      "database_id": "local-lpksaindo-id",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  }
}
