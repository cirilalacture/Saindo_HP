# LPK Saindo 2.0 — Environment Variables & Secrets Template

# Environment Mode (development / staging / production)
ENVIRONMENT=development

# Session Signing Secret (Used by PBKDF2/HMAC Session Verification)
SESSION_SECRET=saindo_dev_session_secret_32_characters_key_here!

# ImgBB API Key (For dynamic blog and gallery image uploads)
IMGBB_API_KEY=your_imgbb_api_key_here

# Cloudflare D1 Database Binding is configured via wrangler.jsonc (DB)
